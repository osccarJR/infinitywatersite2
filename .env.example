# Copiar a .env y rellenar. Vite solo expone las variables VITE_*.
#
# IMPORTANTE: todo lo que empieza por VITE_ acaba dentro del JavaScript
# publico. No poner aqui ningun secreto que no pueda ser leido por
# cualquiera que abra el inspector del navegador.


# ---------------------------------------------------------------------------
# Medicion de conversiones (Google Ads / Analytics)
# ---------------------------------------------------------------------------
# Sin estas variables no se carga ningun script de terceros y no se rastrea
# nada. Asi el entorno de desarrollo no ensucia las estadisticas reales.

# Google Tag Manager. Es la opcion recomendada: permite anadir o quitar
# etiquetas sin volver a desplegar el sitio.
VITE_GTM_ID=

# Google Analytics 4. Se puede usar en vez de GTM, o junto a el.
VITE_GA4_ID=

# Google Ads. Necesario para que las llamadas y los mensajes cuenten como
# conversion en la campana.
VITE_GOOGLE_ADS_ID=

# Etiquetas de cada accion de conversion, tal y como aparecen en Google Ads
# (Herramientas > Conversiones > la accion > etiqueta de conversion).
VITE_ADS_CONVERSION_LABEL_CALL=
VITE_ADS_CONVERSION_LABEL_WHATSAPP=
VITE_ADS_CONVERSION_LABEL_FORM=


# ---------------------------------------------------------------------------
# Resenas de Google
# ---------------------------------------------------------------------------
# Si no se configura ninguna de las dos opciones, la seccion de resenas
# simplemente no aparece. El sitio nunca muestra testimonios inventados.

# OPCION A (recomendada en produccion): un endpoint propio que consulta la
# API de Google, cachea el resultado y devuelve el mismo JSON que Places.
# La clave se queda en el servidor y no se puede robar desde el navegador.
VITE_REVIEWS_ENDPOINT=

# OPCION B: llamada directa desde el navegador. Mas rapida de montar, pero
# la clave queda visible en el bundle. Si se usa, restringirla en Google
# Cloud por referrer HTTP (infinitywatersite.com) y solo a la Places API.
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=


# ---------------------------------------------------------------------------
# Programa de SMS (A2P 10DLC)
# ---------------------------------------------------------------------------
# Numero aprobado que originara los SMS de la campana. Mientras este vacio
# no se muestra en ninguna parte del sitio: publicar un numero equivocado es
# peor que no publicar ninguno. La campana A2P no puede presentarse hasta
# que la web muestre el numero exacto.
VITE_SMS_PHONE_NUMBER=

# NOTA: el formulario de captacion lo sirve GoHighLevel desde
# api.dejavuia.com y lo mantiene Deja Vu IA. La evidencia de consentimiento
# se guarda alli, no en este sitio, asi que no hay webhook que configurar.
