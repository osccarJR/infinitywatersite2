---
/**
 * Plantilla de las paginas de contenido (servicios, problemas, ciudades,
 * guias y empresa), al estilo de una pagina de producto de Apple:
 *  - barra fija con el nombre de la pagina y la accion principal,
 *  - cabecera centrada con titular corto y una frase,
 *  - bloques con mucho aire, uno por pantalla, sin barra lateral,
 *  - el bloque `cta` del contenido se convierte en el cierre de la pagina.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FinalCta from '../components/FinalCta.astro';
import type { Block, ContentPage, Lang, PhotoName } from '../data/types';
import { t } from '../i18n/ui';
import { contentPath, getContentPage, hasPage, pathFor, STATIC_ROUTES } from '../i18n/routes';
import { labelOf } from '../data/labels';
import { SITE_URL, BRAND, WHATSAPP_MESSAGE, whatsappUrl } from '../config/business';
import family from '../assets/photos/family.png';
import smell from '../assets/photos/smell.png';
import stains from '../assets/photos/stains.png';
import contaminants from '../assets/photos/contaminants.png';

interface Props {
  lang: Lang;
  page: ContentPage;
}

const { lang, page } = Astro.props;
const es = lang === 'es';
const ui = t(lang);
const content = page[lang];
const photos: Record<PhotoName, ImageMetadata> = { family, smell, stains, contaminants };
// La foto de la familia ya abre la portada: en paginas interiores solo se
// usan las fotos propias de cada problema.
const photo = page.photo && page.photo !== 'family' ? photos[page.photo] : undefined;

const paths = { en: contentPath(page, 'en'), es: contentPath(page, 'es') };
const related = page.related.filter(hasPage).map((key) => getContentPage(key)).filter(Boolean).slice(0, 3) as ContentPage[];

// El ultimo bloque `cta` pasa a ser el cierre de la pagina.
const ctaBlock = content.blocks.find((b): b is Extract<Block, { type: 'cta' }> => b.type === 'cta');
const blocks = content.blocks.filter((b) => b.type !== 'cta');

const parent =
  page.kind === 'service'
    ? { href: pathFor('services', lang), label: es ? 'Servicios' : 'Services' }
    : page.kind === 'city'
      ? { href: pathFor('areas', lang), label: es ? 'Zonas' : 'Service areas' }
      : null;

const calloutIcon = { info: 'Info', warning: 'AlertTriangle', success: 'CircleCheck' } as const;

/* ------------------------------ JSON-LD ------------------------------ */
const faqItems = content.blocks.flatMap((block) => (block.type === 'faq' ? block.items : []));
const crumbs = [
  { name: BRAND, url: `${SITE_URL}${STATIC_ROUTES.home[lang]}` },
  ...(parent ? [{ name: parent.label, url: `${SITE_URL}${parent.href}` }] : []),
  { name: labelOf(page, lang), url: `${SITE_URL}${paths[lang]}` },
];
const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((crumb, i) => ({ '@type': 'ListItem', position: i + 1, name: crumb.name, item: crumb.url })),
  },
];
if (faqItems.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
if (page.kind === 'service') {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: labelOf(page, lang),
    description: content.metaDescription,
    provider: { '@id': `${SITE_URL}/#business` },
    areaServed: { '@type': 'State', name: 'Florida' },
  });
}
---

<Base lang={lang} title={content.metaTitle} description={content.metaDescription} paths={paths} schema={schema}>
  <!-- Barra de pagina (como la de producto de Apple) -->
  <div class="sticky top-14 z-30 border-b border-black/5 bg-white/80 backdrop-blur-xl backdrop-saturate-150">
    <div class="container-wide flex h-12 items-center gap-4">
      <p class="truncate text-[1.05rem] font-semibold tracking-tight sm:text-xl">
        {parent && <a href={parent.href} class="hidden text-muted hover:text-ink sm:inline">{parent.label} <span aria-hidden="true">›</span> </a>}
        {labelOf(page, lang)}
      </p>
      <a href={pathFor('freeWaterTest', lang)} class="ml-auto inline-flex min-h-9 shrink-0 items-center whitespace-nowrap rounded-full bg-accent px-4 text-[0.8rem] font-semibold text-white hover:bg-accent-hover" data-track="free_test_cta" data-location={`${page.kind}-subnav`}>
        {ui.cta.freeTestShort}
      </a>
    </div>
  </div>

  <!-- Cabecera -->
  <header class="pb-6 pt-16 text-center sm:pt-24">
    <div class="container-x">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1 class="mx-auto mt-3 max-w-4xl text-[2.6rem] leading-[1.05] sm:text-6xl lg:text-7xl">{content.title}</h1>
      <p class="t-lead mx-auto mt-6 max-w-2xl">{content.lead}</p>
      <ul class="mx-auto mt-9 flex max-w-3xl flex-wrap justify-center gap-x-8 gap-y-3 text-[1.02rem]">
        {content.highlights.map((item) => (
          <li class="flex items-center gap-2"><Icon name="CircleCheck" class="h-5 w-5 text-accent" />{item}</li>
        ))}
      </ul>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
        <a href={pathFor('freeWaterTest', lang)} class="btn btn-primary !min-h-13 w-full !px-8 !text-lg sm:w-auto" data-track="free_test_cta" data-location={`${page.kind}-hero`}>{ui.cta.freeTest}</a>
        <a href={whatsappUrl(WHATSAPP_MESSAGE[lang])} target="_blank" rel="noopener" class="btn btn-wa !min-h-13 w-full !px-7 sm:w-auto" data-track="whatsapp" data-location={`${page.kind}-hero`}><Icon name="MessageCircle" />WhatsApp</a>
      </div>
    </div>
    {photo && (
      <div class="container-wide mt-14">
        <Image src={photo} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1320px) 1280px, 96vw" class="aspect-[4/3] w-full rounded-[2rem] object-cover sm:aspect-[21/9] sm:rounded-[2.5rem]" loading="eager" />
      </div>
    )}
  </header>

  <!-- Bloques -->
  {blocks.map((block, index) => {
    const alt = index % 2 === 1;
    return (
      <>
      <section class:list={['py-20 sm:py-28', alt && 'bg-mist']}>
        {block.type === 'prose' && (
          <div class="container-x reveal max-w-3xl text-center">
            {block.heading && <h2 class="text-4xl sm:text-5xl">{block.heading}</h2>}
            <div class:list={['text-xl leading-relaxed text-muted sm:text-[1.35rem]', block.heading && 'mt-6']}>
              {block.paragraphs.map((p) => <p class="[&+p]:mt-4">{p}</p>)}
            </div>
          </div>
        )}

        {block.type === 'features' && (
          <div class="container-x">
            <h2 class="reveal mx-auto max-w-3xl text-center text-4xl sm:text-5xl">{block.heading}</h2>
            {block.intro && <p class="reveal mx-auto mt-5 max-w-2xl text-center text-xl text-muted">{block.intro}</p>}
            <div class:list={['mt-14 grid gap-4', block.items.length === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2']}>
              {block.items.map((item) => (
                <div class:list={['reveal rounded-[2rem] p-8 sm:p-10', alt ? 'bg-white' : 'bg-mist']}>
                  <Icon name={item.icon} class="h-8 w-8 text-accent" strokeWidth={1.6} />
                  <h3 class="mt-6 text-2xl">{item.title}</h3>
                  <p class="mt-2 text-lg leading-relaxed text-muted">{item.text}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        {block.type === 'steps' && (
          <div class="container-x">
            <h2 class="reveal mx-auto max-w-3xl text-center text-4xl sm:text-5xl">{block.heading}</h2>
            {block.intro && <p class="reveal mx-auto mt-5 max-w-2xl text-center text-xl text-muted">{block.intro}</p>}
            <ol class:list={['mt-16 grid gap-10', block.items.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3']}>
              {block.items.map((item, i) => (
                <li class="reveal text-center sm:text-left">
                  <span class="text-gradient text-6xl font-bold tracking-tight">{i + 1}</span>
                  <h3 class="mt-3 text-2xl">{item.title}</h3>
                  <p class="mt-2 text-lg leading-relaxed text-muted">{item.text}</p>
                </li>
              ))}
            </ol>
          </div>
        )}

        {block.type === 'facts' && (
          <div class="container-x">
            <p class="reveal text-center text-lg font-semibold text-accent">{block.kicker ?? (es ? 'Datos oficiales' : 'Official data')}</p>
            <h2 class="reveal mx-auto mt-2 max-w-3xl text-center text-4xl sm:text-5xl">{block.heading}</h2>
            {block.intro && <p class="reveal mx-auto mt-5 max-w-2xl text-center text-xl text-muted">{block.intro}</p>}
            <dl class:list={['mt-14 grid gap-4 sm:grid-cols-2', block.items.length === 3 && 'lg:grid-cols-3', block.items.length >= 4 && block.items.every((item) => item.value.length <= 12) && 'lg:grid-cols-4']}>
              {block.items.map((item) => (
                <div class:list={['reveal flex flex-col rounded-[2rem] p-8 text-center', alt ? 'bg-white' : 'bg-mist']}>
                  <dt class="order-2 mt-2 text-[1.02rem] font-medium text-muted">{item.label}</dt>
                  <dd class="order-1 text-3xl font-bold tracking-tight sm:text-4xl">{item.value}</dd>
                  {item.detail && <dd class="order-3 mt-2 text-sm text-muted">{item.detail}</dd>}
                </div>
              ))}
            </dl>
            {block.source && (
              <p class="mt-8 text-center text-sm text-muted">
                {es ? 'Fuente:' : 'Source:'} <a href={block.source.url} target="_blank" rel="noopener" class="link">{block.source.label} ↗</a>
              </p>
            )}
          </div>
        )}

        {block.type === 'signs' && (
          <div class="container-x max-w-4xl">
            <h2 class="reveal text-center text-4xl sm:text-5xl">{block.heading}</h2>
            {block.intro && <p class="reveal mx-auto mt-5 max-w-2xl text-center text-xl text-muted">{block.intro}</p>}
            <ul class="mt-12 grid gap-x-10 gap-y-5 sm:grid-cols-2">
              {block.items.map((item) => (
                <li class="reveal flex items-start gap-3 text-xl"><Icon name="CircleCheck" class="mt-1 h-6 w-6 shrink-0 text-accent" />{item}</li>
              ))}
            </ul>
          </div>
        )}

        {block.type === 'callout' && (
          <div class="container-x reveal max-w-3xl text-center">
            <Icon name={calloutIcon[block.tone]} class:list={['mx-auto h-10 w-10', block.tone === 'warning' ? 'text-coral' : 'text-accent']} strokeWidth={1.6} />
            <h2 class="mt-5 text-3xl sm:text-4xl">{block.title}</h2>
            <p class="mt-4 text-xl leading-relaxed text-muted">{block.text}</p>
          </div>
        )}

        {block.type === 'compare' && (
          <div class="container-x max-w-4xl">
            <h2 class="reveal text-center text-4xl sm:text-5xl">{block.heading}</h2>
            {block.intro && <p class="reveal mx-auto mt-5 max-w-2xl text-center text-xl text-muted">{block.intro}</p>}
            <div class="reveal mt-12 overflow-x-auto">
              <table class="w-full min-w-[32rem] border-collapse text-left text-[1.02rem]">
                <thead>
                  <tr class="border-b border-line">
                    <th scope="col" class="w-1/4 py-4 pr-4"><span class="sr-only">{es ? 'Aspecto' : 'Aspect'}</span></th>
                    <th scope="col" class="py-4 pr-4 text-lg font-semibold">{block.columns[0]}</th>
                    <th scope="col" class="py-4 text-lg font-semibold">{block.columns[1]}</th>
                  </tr>
                </thead>
                <tbody>
                  {block.rows.map((row) => (
                    <tr class="border-b border-line align-top">
                      <th scope="row" class="py-5 pr-4 font-semibold">{row.label}</th>
                      <td class="py-5 pr-4 text-muted">{row.values[0]}</td>
                      <td class="py-5 text-muted">{row.values[1]}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {block.type === 'faq' && (
          <div class="container-x max-w-3xl">
            <h2 class="reveal text-center text-4xl sm:text-5xl">{block.heading}</h2>
            <div class="reveal mt-12 border-t border-line">
              {block.items.map((item) => (
                <details class="group border-b border-line">
                  <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 text-xl font-semibold">
                    {item.q}
                    <Icon name="Plus" class="h-6 w-6 shrink-0 text-muted transition duration-300 group-open:rotate-45" />
                  </summary>
                  <p class="pb-7 pr-10 text-lg leading-relaxed text-muted">{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        )}
      </section>
      {index === 1 && blocks.length > 3 && page.kind !== 'company' && page.key !== 'prices' && (
        <section class="container-wide py-4">
          <div class="flex flex-col items-center justify-between gap-6 rounded-[2rem] bg-night px-8 py-10 text-center text-white sm:flex-row sm:px-12 sm:text-left">
            <div>
              <p class="text-2xl font-bold tracking-tight sm:text-3xl">{es ? '¿Te pasa esto?' : 'Sound familiar?'}</p>
              <p class="mt-1 text-lg text-white/70">{es ? 'Lo medimos gratis en tu casa y te decimos qué es.' : 'We test it free at home and tell you what it is.'}</p>
            </div>
            <a href={pathFor('freeWaterTest', lang)} class="btn btn-primary shrink-0 !min-h-13 !px-8" data-track="free_test_cta" data-location={`${page.kind}-mid`}>{ui.cta.freeTest}</a>
          </div>
        </section>
      )}
      </>
    );
  })}

  <FinalCta lang={lang} title={ctaBlock?.title} text={ctaBlock?.text} location={`${page.kind}-final`} />

  <!-- Sigue explorando -->
  {related.length > 0 && (
    <section class="py-20">
      <div class="container-x">
        <h2 class="text-center text-3xl sm:text-4xl">{es ? 'Sigue explorando.' : 'Keep exploring.'}</h2>
        <div class="mt-10 grid gap-4 sm:grid-cols-3">
          {related.map((rel) => (
            <a href={contentPath(rel, lang)} class="group rounded-[2rem] bg-mist p-8 transition hover:bg-[#ebebef]">
              <Icon name={rel.icon} class="h-8 w-8 text-accent" strokeWidth={1.6} />
              <p class="mt-5 text-xl font-semibold tracking-tight">{labelOf(rel, lang)}</p>
              <span class="more mt-2">{es ? 'Ver' : 'View'}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</Base>
