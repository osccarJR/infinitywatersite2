---
/**
 * /free-water-test — el UNICO punto de captura del sitio (requisito A2P).
 *
 * El formulario lo construye y mantiene Deja Vu IA en GoHighLevel: ahi
 * viven los campos, las dos casillas de consentimiento y el registro de la
 * evidencia. Aqui NO se duplican campos ni textos de consentimiento; esta
 * pagina aporta contexto y los tres enlaces legales visibles antes del
 * formulario.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import type { Lang } from '../data/types';
import { pathFor, STATIC_ROUTES } from '../i18n/routes';
import { CONCERNS } from '../data/waterCheck';
import {
  FOUNDER_YEARS,
  LEGAL_ENTITY_DBA,
  SMS_PHONE_NUMBER,
  SUPPORT_PHONE,
  WHATSAPP_MESSAGE,
  whatsappUrl,
} from '../config/business';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';

const FORM_ID = 'LgLxNfMMaa7apAp6aDB4';
const FORM_ORIGIN = 'https://api.dejavuia.com';
const FORM_SRC = `${FORM_ORIGIN}/widget/form/${FORM_ID}`;
/** Alto inicial; form_embed.js lo ajusta al formulario real al cargar. */
const FALLBACK_HEIGHT = 820;

const c = es
  ? {
      metaTitle: 'Análisis de Agua Gratis | Infinity Water',
      metaDescription:
        'Solicita tu análisis de agua gratuito en casa en Florida. Dinos si tu hogar recibe agua de pozo o de ciudad y coordinamos la visita. Sin compromiso de compra.',
      eyebrow: 'Análisis de agua gratis',
      title: 'Solicita tu análisis de agua gratuito en casa',
      intro:
        'Déjanos tus datos y te llamamos para agendar el análisis en tu casa. Enviar esta solicitud no te obliga a comprar.',
      includesTitle: 'Qué incluye la visita',
      includes: [
        { icon: 'FlaskConical', title: 'Medimos en casa', text: 'Pozo o llave.' },
        { icon: 'Search', title: 'Revisamos todo', text: 'Tuberías y equipos.' },
        { icon: 'FileText', title: 'Te lo explicamos', text: 'Claro y en español.' },
        { icon: 'HeartHandshake', title: 'Cero presión', text: 'Sin compromiso.' },
      ],
      promise: `Más de ${FOUNDER_YEARS} años de experiencia de nuestro fundador. Por ley de Florida, cualquier compra hecha en tu casa se puede cancelar hasta la medianoche del 3.er día hábil.`,
      legalHeading: 'Antes de enviar el formulario',
      legalIntro:
        'El consentimiento de mensajes de texto es opcional y no es necesario para enviar este formulario ni para comprar ningún producto o servicio. Consulta:',
      links: { privacy: 'Política de Privacidad', terms: 'Términos y Condiciones', smsPolicy: 'Política de SMS' },
      formTitle: 'Formulario de solicitud de análisis de agua gratuito',
      altTitle: '¿Prefieres hablar con alguien?',
      whatsapp: 'Escríbenos por WhatsApp',
      phoneLabel: 'Llámanos:',
      smsLabel: 'Texto/SMS',
      operatedBy: `Operado por ${LEGAL_ENTITY_DBA}.`,
    }
  : {
      metaTitle: 'Free Water Test | Infinity Water',
      metaDescription:
        'Request your free home water analysis in Florida. Tell us whether your home uses well water or city water and we will coordinate the visit. No obligation to purchase.',
      eyebrow: 'Free water test',
      title: 'Request your free home water analysis',
      intro:
        'Leave your details and we’ll call you to schedule the test at your home. Submitting this request does not obligate you to purchase anything.',
      includesTitle: 'What the visit includes',
      includes: [
        { icon: 'FlaskConical', title: 'We test at home', text: 'Well or tap.' },
        { icon: 'Search', title: 'We check it all', text: 'Pipes and equipment.' },
        { icon: 'FileText', title: 'We explain it', text: 'In plain language.' },
        { icon: 'HeartHandshake', title: 'Zero pressure', text: 'No obligation.' },
      ],
      promise: `Backed by our founder’s ${FOUNDER_YEARS}+ years of experience. Under Florida law, any purchase made in your home can be canceled until midnight of the third business day.`,
      legalHeading: 'Before you send the form',
      legalIntro:
        'Text message consent is optional and is not required to submit this form or to purchase any product or service. Please review:',
      links: { privacy: 'Privacy Policy', terms: 'Terms & Conditions', smsPolicy: 'SMS Policy' },
      formTitle: 'Free water analysis request form',
      altTitle: 'Prefer to talk to someone?',
      whatsapp: 'Message us on WhatsApp',
      phoneLabel: 'Call:',
      smsLabel: 'Text/SMS',
      operatedBy: `Operated by ${LEGAL_ENTITY_DBA}.`,
    };

const legalLinks = [
  { key: 'privacy', icon: 'ShieldCheck' },
  { key: 'terms', icon: 'FileText' },
  { key: 'smsPolicy', icon: 'MessageCircle' },
] as const;
---

<Base lang={lang} title={c.metaTitle} description={c.metaDescription} paths={STATIC_ROUTES.freeWaterTest} onFormPage>
  <link slot="head" rel="preconnect" href={FORM_ORIGIN} />

  <section class="bg-mist pb-24 pt-14 sm:pt-20">
    <div class="container-x max-w-3xl text-center">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="mt-3 text-[2.4rem] leading-[1.05] sm:text-6xl">{c.title}</h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{c.intro}</p>

      <!-- "Tu caso": el contexto que trae el cliente desde el cuestionario -->
      <p class="mx-auto mt-6 hidden w-fit max-w-full flex-wrap items-center justify-center gap-2 rounded-full bg-white px-5 py-2.5 text-[0.95rem]" data-case
        data-l-case={es ? 'Tu caso:' : 'Your case:'}
        data-l-well={es ? 'Agua de pozo' : 'Well water'}
        data-l-city={es ? 'Agua de ciudad' : 'City water'}
        data-l-concerns={JSON.stringify(Object.fromEntries(CONCERNS.map((con) => [con.id, con.label[lang]])))}></p>

      <ul class="mt-10 grid grid-cols-2 gap-3 text-left sm:grid-cols-4">
        {c.includes.map((item) => (
          <li class="rounded-3xl bg-white p-5">
            <Icon name={item.icon} class="h-6 w-6 text-accent" strokeWidth={1.6} />
            <span class="mt-3 block font-semibold leading-tight">{item.title}</span>
            <span class="mt-1 block text-sm text-muted">{item.text}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="container-x mt-10 max-w-2xl">
      <!-- Los enlaces legales van ANTES del formulario (A2P), visibles sin
           depender de que el iframe haya cargado. -->
      <div class="rounded-3xl bg-white p-6">
        <h2 class="text-base font-semibold tracking-normal">{c.legalHeading}</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-muted">{c.legalIntro}</p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
          {legalLinks.map(({ key, icon }) => (
            <li>
              <a href={pathFor(key, lang)} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline">
                <Icon name={icon} class="h-4 w-4" />{c.links[key]}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- form_embed.js oculta el iframe hasta que el formulario avisa de
           que cargo; el marcador de detras reserva el espacio mientras. -->
      <div class="relative mt-4 min-h-[820px] overflow-hidden rounded-[2rem] bg-white">
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 text-muted" aria-hidden="true">
          <span class="h-9 w-9 animate-spin rounded-full border-[3px] border-accent/20 border-t-accent"></span>
          <span class="text-sm font-medium">{es ? 'Cargando formulario…' : 'Loading form…'}</span>
        </div>
          <iframe
            src={FORM_SRC}
            data-src={FORM_SRC}
            data-ghl-form
            data-thanks={pathFor('thanks', lang)}
            id={`inline-${FORM_ID}`}
            title={c.formTitle}
            style={`width:100%;height:${FALLBACK_HEIGHT}px;border:none;display:block;position:relative;background:#fff`}
            data-layout='{"id":"INLINE"}'
            data-trigger-type="alwaysShow"
            data-trigger-value=""
            data-activation-type="alwaysActivated"
            data-activation-value=""
            data-deactivation-type="neverDeactivate"
            data-deactivation-value=""
            data-form-name="Free water test"
            data-height={FALLBACK_HEIGHT}
            data-layout-iframe-id={`inline-${FORM_ID}`}
            data-form-id={FORM_ID}></iframe>
      </div>

      <p class="mt-8 flex items-start justify-center gap-2 text-center text-sm leading-relaxed text-muted">
        <Icon name="Scale" class="mt-0.5 h-4 w-4 shrink-0 text-accent" />{c.promise}
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-8">
        <a href={whatsappUrl(WHATSAPP_MESSAGE[lang])} target="_blank" rel="noopener" class="more" data-track="whatsapp" data-location="form-page">{c.whatsapp}</a>
        <a href={`tel:${SUPPORT_PHONE.tel}`} class="more" data-track="call" data-location="form-page">{c.phoneLabel} {SUPPORT_PHONE.display}</a>
      </div>
      {SMS_PHONE_NUMBER && <p class="mt-3 text-center text-sm text-muted">{c.smsLabel}: <strong class="text-ink">{SMS_PHONE_NUMBER}</strong></p>}
      <p class="mt-3 text-center text-xs text-muted">{c.operatedBy}</p>
    </div>
  </section>

  <script>
    import { initGhlForm } from '../scripts/ghl';
    initGhlForm();

    // Muestra "Tu caso" si el cliente viene del cuestionario.
    const box = document.querySelector<HTMLElement>('[data-case]');
    const q = new URLSearchParams(location.search);
    if (box && (q.get('water_source') || q.get('concerns') || q.get('zip'))) {
      const labels: Record<string, string> = JSON.parse(box.dataset.lConcerns || '{}');
      const parts = [
        q.get('water_source') === 'well' ? box.dataset.lWell : q.get('water_source') === 'city' ? box.dataset.lCity : '',
        ...(q.get('concerns') || '').split(',').map((id) => labels[id]).filter(Boolean),
        /^\d{5}$/.test(q.get('zip') || '') ? q.get('zip') : '',
      ].filter(Boolean) as string[];
      if (parts.length) {
        const strong = document.createElement('strong');
        strong.textContent = box.dataset.lCase ?? '';
        box.append(strong, ' ' + parts.join(' · '));
        box.classList.replace('hidden', 'flex');
      }
    }
  </script>
  <script is:inline src="https://api.dejavuia.com/js/form_embed.js" defer></script>
</Base>
