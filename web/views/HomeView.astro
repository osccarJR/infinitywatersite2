---
/**
 * Portada. Construida sobre el analisis de negocio (sept-2026):
 *
 *  1. Primera pantalla que responde en 5 segundos: que problema resolvemos,
 *     para quien (pozo, SW Florida, en espanol), que hago (boton) y por que
 *     confiar (fila de confianza). El vaso animado se queda como un solo
 *     bloque de marca, no como una historia de 5 pantallas.
 *  2. Cuestionario de 4 pasos: califica y diagnostica antes de pedir datos.
 *  3. Como es la visita (1-2-3) + ejemplo de resultado.
 *  4. Nuestro compromiso: la respuesta a la desconfianza del sector.
 *  5. Pozo o ciudad.
 *  6. Resenas (cuando haya Place ID) y cierre.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import WaterStage from '../components/WaterStage.astro';
import WaterQuiz from '../components/WaterQuiz.astro';
import WaterGlass from '../components/WaterGlass.astro';
import FinalCta from '../components/FinalCta.astro';
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import { pathFor, STATIC_ROUTES } from '../i18n/routes';
import { getReviews } from '../lib/reviews';
import {
  FOUNDER_YEARS,
  GOOGLE_PROFILE_URL,
  MADE_IN_USA,
  PRIMARY_PHONE,
  SEALS,
  TEAM_PHOTOS,
  WARRANTY,
  WHATSAPP_MESSAGE,
  whatsappUrl,
} from '../config/business';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';
const ui = t(lang);
const link = (key: string) => pathFor(key, lang);
const reviews = await getReviews(lang);
const wqa = SEALS.find((seal) => seal.id === 'wqa' && seal.enabled);

const c = es
  ? {
      metaTitle: 'Infinity Water | Análisis de agua gratis en Fort Myers y SW Florida',
      metaDescription: `Especialistas en agua de pozo y de ciudad en Fort Myers, Cape Coral, Lehigh Acres y Naples. Análisis gratis en tu casa, en español y sin presión. ${FOUNDER_YEARS}+ años de experiencia.`,
      area: 'Fort Myers · Cape Coral · Lehigh Acres · Naples',
      titleA: '¿Tu agua huele, mancha o sabe mal?',
      titleB: 'Tiene solución.',
      lead: 'Somos especialistas en agua de pozo. Analizamos tu agua gratis en tu casa, te la explicamos en español y te decimos la verdad, aunque no necesites nada.',
      orCall: 'o llama al',
      trust: [
        { icon: 'BadgeCheck', text: `${FOUNDER_YEARS}+ años de experiencia` },
        { icon: 'Languages', text: 'Todo en español' },
        { icon: 'HeartHandshake', text: 'Sin presión ni compromiso' },
      ],
      testEyebrow: 'La visita',
      testTitle: 'Así es tu análisis gratis.',
      steps: [
        { title: 'Agendas', text: 'Por el formulario, WhatsApp o teléfono.' },
        { title: 'Vamos a tu casa', text: 'Medimos tu agua y revisamos tu instalación.' },
        { title: 'Te explicamos todo', text: 'Qué encontramos y si hace falta hacer algo.' },
        { title: 'Tú decides', text: 'Propuesta por escrito. Sin presión.' },
      ],
      report: {
        title: 'Ejemplo de resultado',
        sub: 'Agua de pozo · Lehigh Acres',
        rows: [
          { label: 'Azufre', value: 'Alto', level: 82, tone: 'bad' },
          { label: 'Hierro', value: 'Alto', level: 70, tone: 'bad' },
          { label: 'Dureza', value: 'Media', level: 48, tone: 'mid' },
          { label: 'pH', value: 'Normal', level: 34, tone: 'ok' },
        ],
        verdict: 'Recomendación: inyección de aire + filtro de hierro.',
      },
      promiseTitle: 'Nuestro compromiso contigo.',
      promiseLead: 'Sabemos que en este rubro hay mucha presión y promesas exageradas. Nosotros trabajamos así:',
      promises: [
        { icon: 'Search', title: 'Te decimos la verdad', text: 'Si tu agua está bien, te lo decimos y ahí termina la visita.' },
        { icon: 'FileText', title: 'Todo por escrito, en español', text: 'La propuesta, el precio y el contrato, en tu idioma.' },
        { icon: 'Scale', title: '3 días para cancelar', text: 'Por ley de Florida, si compras en casa. Te lo explicamos antes de firmar.' },
        { icon: 'ShieldCheck', title: WARRANTY.es.short, text: 'Garantía de fábrica en cada pieza, gestionada por nosotros.' },
      ],
      yearsLabel: 'años de experiencia de nuestro fundador tratando agua en Florida',
      madeInUsa: 'Equipos fabricados en EE. UU.',
      financing: 'Financiamiento disponible',
      well: { eyebrow: 'Agua de pozo', title: 'Nuestra especialidad.', text: 'Azufre, hierro y dureza, resueltos a la medida de tu pozo.' },
      city: { eyebrow: 'Agua de ciudad', title: 'Adiós al sabor a cloro.', text: 'Y si tu agua está bien, te lo decimos.' },
      more: 'Más información',
      reviewsTitle: 'Lo que dicen nuestros clientes.',
      reviewsLink: 'Ver todas en Google',
    }
  : {
      metaTitle: 'Infinity Water | Free Water Test in Fort Myers & SW Florida',
      metaDescription: `Well and city water specialists in Fort Myers, Cape Coral, Lehigh Acres and Naples. Free in-home water test, no pressure, English or Spanish. ${FOUNDER_YEARS}+ years of experience.`,
      area: 'Fort Myers · Cape Coral · Lehigh Acres · Naples',
      titleA: 'Does your water smell, stain or taste off?',
      titleB: 'There’s a fix.',
      lead: 'We’re well water specialists. We test your water free at home, explain it in plain language and tell you the truth — even if you don’t need anything.',
      orCall: 'or call',
      trust: [
        { icon: 'BadgeCheck', text: `${FOUNDER_YEARS}+ years of experience` },
        { icon: 'Languages', text: 'English or Spanish' },
        { icon: 'HeartHandshake', text: 'No pressure, no obligation' },
      ],
      testEyebrow: 'The visit',
      testTitle: 'Here’s how your free test works.',
      steps: [
        { title: 'You book', text: 'Through the form, WhatsApp or phone.' },
        { title: 'We come to you', text: 'We test your water and check your plumbing.' },
        { title: 'We explain it all', text: 'What we found and whether anything is needed.' },
        { title: 'You decide', text: 'Written proposal. No pressure.' },
      ],
      report: {
        title: 'Sample result',
        sub: 'Well water · Lehigh Acres',
        rows: [
          { label: 'Sulfur', value: 'High', level: 82, tone: 'bad' },
          { label: 'Iron', value: 'High', level: 70, tone: 'bad' },
          { label: 'Hardness', value: 'Medium', level: 48, tone: 'mid' },
          { label: 'pH', value: 'Normal', level: 34, tone: 'ok' },
        ],
        verdict: 'Recommendation: air injection + iron filter.',
      },
      promiseTitle: 'Our commitment to you.',
      promiseLead: 'This industry has a reputation for pressure and overpromising. Here’s how we work instead:',
      promises: [
        { icon: 'Search', title: 'We tell you the truth', text: 'If your water is fine, we say so — and that’s the end of the visit.' },
        { icon: 'FileText', title: 'Everything in writing', text: 'Proposal, price and contract, in English or Spanish.' },
        { icon: 'Scale', title: '3 days to cancel', text: 'Florida law, for in-home purchases. We explain it before you sign.' },
        { icon: 'ShieldCheck', title: WARRANTY.en.short, text: 'Factory warranty on every part, handled by us.' },
      ],
      yearsLabel: 'years of our founder’s experience treating Florida water',
      madeInUsa: 'Made in USA equipment',
      financing: 'Financing available',
      well: { eyebrow: 'Well water', title: 'Our specialty.', text: 'Sulfur, iron and hardness, solved for your well.' },
      city: { eyebrow: 'City water', title: 'Goodbye, chlorine taste.', text: 'And if your water is fine, we’ll tell you.' },
      more: 'Learn more',
      reviewsTitle: 'What our customers say.',
      reviewsLink: 'See all on Google',
    };

const tone = { bad: '#ff6b4a', mid: '#f5b400', ok: '#34c759' } as const;
---

<Base lang={lang} title={c.metaTitle} description={c.metaDescription} paths={STATIC_ROUTES.home}>
  <!-- 1 · PRIMERA PANTALLA ------------------------------------------------ -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#eef6fc] via-white to-white">
    <div class="container-wide grid items-center gap-10 pb-16 pt-10 sm:pt-14 lg:min-h-[min(calc(100svh-3.5rem),62rem)] lg:grid-cols-[1.1fr_1fr] lg:gap-14 lg:py-16">
      <div class="text-center lg:text-left">
        <p class="inline-flex items-center gap-1.5 text-[0.78rem] font-semibold text-accent min-[380px]:text-sm sm:text-base">
          <Icon name="MapPin" class="h-4 w-4 shrink-0" />{c.area}
        </p>
        <h1 class="mt-4 text-[clamp(2.3rem,1.2rem+3.6vw,4.4rem)] leading-[1.04]">
          {c.titleA} <span class="text-gradient">{c.titleB}</span>
        </h1>
        <p class="t-lead mx-auto mt-6 max-w-xl lg:mx-0">{c.lead}</p>

        <div class="mt-9 flex flex-col items-center gap-4 sm:flex-row sm:justify-center lg:justify-start">
          <a href="#cuestionario" class="btn btn-primary !min-h-14 w-full !px-8 !text-lg sm:w-auto" data-track="free_test_cta" data-location="hero">{ui.cta.freeTest}</a>
          <a href={whatsappUrl(WHATSAPP_MESSAGE[lang])} target="_blank" rel="noopener" class="btn btn-wa !min-h-14 w-full !px-7 sm:w-auto" data-track="whatsapp" data-location="hero">
            <Icon name="MessageCircle" />WhatsApp
          </a>
        </div>
        <p class="mt-4 text-[0.95rem] text-muted">
          {c.orCall} <a href={`tel:${PRIMARY_PHONE.tel}`} class="font-semibold text-ink underline decoration-line underline-offset-4 hover:decoration-ink" data-track="call" data-location="hero">{PRIMARY_PHONE.display}</a>
        </p>

        <!-- Fila de confianza -->
        <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-line pt-6 text-left text-[0.92rem] sm:flex sm:flex-wrap sm:items-center sm:justify-center sm:gap-x-6 sm:text-[0.95rem] lg:justify-start">
          {reviews?.rating && (
            <li class="flex items-center gap-1.5 font-semibold"><span class="text-amber-500">★</span>{reviews.rating.toFixed(1)} <span class="font-normal text-muted">({reviews.total} Google)</span></li>
          )}
          {c.trust.map((item) => (
            <li class="flex items-center gap-2"><Icon name={item.icon} class="h-5 w-5 text-accent" />{item.text}</li>
          ))}
          {wqa && (
            <li class="flex items-center gap-2"><img src={wqa.image} alt="" width="28" height="28" class="h-7 w-auto" />{es ? 'Miembro WQA' : 'WQA member'}</li>
          )}
        </ul>
      </div>

      <WaterStage lang={lang} class="mx-auto w-full max-w-md lg:max-w-none" />
    </div>
  </section>

  <!-- 2 · CUESTIONARIO ---------------------------------------------------- -->
  <section id="cuestionario" class="scroll-mt-20 bg-mist py-20 sm:py-28">
    <div class="container-x">
      <WaterQuiz lang={lang} />
    </div>
  </section>

  <!-- 3 · LA VISITA -------------------------------------------------------- -->
  <section class="py-20 sm:py-28">
    <div class="container-x grid items-center gap-14 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
      <div>
        <p class="eyebrow">{c.testEyebrow}</p>
        <h2 class="t-section mt-2">{c.testTitle}</h2>
        <ol class="mt-10 space-y-6">
          {c.steps.map((step, i) => (
            <li class="flex items-start gap-5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-mist text-lg font-bold text-accent">{i + 1}</span>
              <span>
                <span class="block text-xl font-semibold tracking-tight">{step.title}</span>
                <span class="block text-lg text-muted">{step.text}</span>
              </span>
            </li>
          ))}
        </ol>
        <a href={link('freeWaterTest')} class="btn btn-primary mt-10 !min-h-13 !px-8 !text-lg" data-track="free_test_cta" data-location="visit">{ui.cta.freeTest}</a>
      </div>

      <div class="reveal report mx-auto w-full max-w-md rounded-[2.25rem] bg-mist p-3">
        <div class="rounded-[1.8rem] bg-white p-7 shadow-soft sm:p-9">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-2xl font-bold tracking-tight">{c.report.title}</p>
              <p class="text-sm text-muted">{c.report.sub}</p>
            </div>
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-mist"><Icon name="FlaskConical" class="h-6 w-6 text-accent" /></span>
          </div>
          <ul class="mt-8 space-y-6">
            {c.report.rows.map((row, i) => (
              <li>
                <div class="flex justify-between text-[1.02rem]"><span class="font-medium">{row.label}</span><span class="font-semibold" style={`color:${tone[row.tone as keyof typeof tone]}`}>{row.value}</span></div>
                <div class="mt-2 h-2 overflow-hidden rounded-full bg-mist">
                  <div class="bar h-full rounded-full" style={`--w:${row.level}%;background:${tone[row.tone as keyof typeof tone]};transition-delay:${0.25 + i * 0.12}s`}></div>
                </div>
              </li>
            ))}
          </ul>
          <p class="mt-8 flex items-start gap-2 rounded-2xl bg-mist p-4 text-[0.95rem] font-medium"><Icon name="CircleCheck" class="mt-0.5 h-5 w-5 shrink-0 text-accent" />{c.report.verdict}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · COMPROMISO (y la familia, cuando haya fotos reales) --------------- -->
  <section class="bg-night py-20 text-white sm:py-28" data-nav="dark">
    <div class="container-x">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
        <div>
          <h2 class="t-section">{c.promiseTitle}</h2>
          <p class="mt-5 text-lg text-white/70">{c.promiseLead}</p>
          <div class="mt-10 flex items-center gap-5">
            <span class="text-gradient text-[clamp(3.5rem,2.5rem+3vw,5.5rem)] font-bold leading-none tracking-tight">{FOUNDER_YEARS}+</span>
            <span class="max-w-[12rem] text-[0.95rem] leading-snug text-white/70">{c.yearsLabel}</span>
          </div>
          {TEAM_PHOTOS.length > 0 && (
            <div class="mt-10 grid grid-cols-2 gap-3">
              {TEAM_PHOTOS.slice(0, 4).map((photo) => (
                <img src={photo.src} alt={photo.alt[lang]} class="aspect-square w-full rounded-2xl object-cover" loading="lazy" />
              ))}
            </div>
          )}
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {c.promises.map((p) => (
            <li class="rounded-[1.75rem] bg-white/[0.06] p-7 ring-1 ring-white/10">
              <Icon name={p.icon} class="h-7 w-7 text-[#5ec2ff]" strokeWidth={1.6} />
              <h3 class="mt-5 text-xl">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-white/70">{p.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 border-t border-white/10 pt-8 text-white/80">
        {MADE_IN_USA && <span class="flex items-center gap-2"><Icon name="Flag" class="h-5 w-5 text-[#5ec2ff]" />{c.madeInUsa}</span>}
        <a href={link('financing')} class="flex items-center gap-2 hover:text-white"><Icon name="CreditCard" class="h-5 w-5 text-[#5ec2ff]" />{c.financing} ›</a>
        <a href={link('prices')} class="flex items-center gap-2 hover:text-white"><Icon name="DollarSign" class="h-5 w-5 text-[#5ec2ff]" />{es ? '¿Cuánto cuesta? Guía de precios' : 'What does it cost? Price guide'} ›</a>
      </p>
    </div>
  </section>

  <!-- 5 · POZO O CIUDAD ---------------------------------------------------- -->
  <section class="container-wide grid gap-4 py-4 lg:grid-cols-2">
    <a href={link('well-water')} data-nav="dark" class="group relative flex min-h-[30rem] flex-col items-center overflow-hidden rounded-[2rem] bg-black px-8 pt-12 text-center text-white sm:min-h-[34rem] sm:rounded-[2.5rem]" data-water="iron">
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-[radial-gradient(50%_60%_at_50%_85%,rgb(194_88_31/0.35),transparent)]"></div>
      <p class="relative text-lg font-semibold text-[#5ec2ff]">{c.well.eyebrow}</p>
      <h2 class="relative mt-2 text-[clamp(2rem,1.2rem+2.4vw,3.2rem)]">{c.well.title}</h2>
      <p class="relative mt-3 max-w-sm text-lg text-white/70">{c.well.text}</p>
      <span class="more relative mt-5 !text-[#5ec2ff]">{c.more}</span>
      <WaterGlass id="tile-well" class="relative mt-auto h-64 w-auto translate-y-6 transition duration-700 group-hover:translate-y-0 sm:h-80" />
    </a>
    <a href={link('city-water')} class="group relative flex min-h-[30rem] flex-col items-center overflow-hidden rounded-[2rem] bg-mist px-8 pt-12 text-center sm:min-h-[34rem] sm:rounded-[2.5rem]" data-water="clear">
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-[radial-gradient(50%_60%_at_50%_85%,rgb(22_179_212/0.22),transparent)]"></div>
      <p class="relative text-lg font-semibold text-accent">{c.city.eyebrow}</p>
      <h2 class="relative mt-2 text-[clamp(2rem,1.2rem+2.4vw,3.2rem)]">{c.city.title}</h2>
      <p class="relative mt-3 max-w-sm text-lg text-muted">{c.city.text}</p>
      <span class="more relative mt-5">{c.more}</span>
      <WaterGlass id="tile-city" on="light" class="relative mt-auto h-64 w-auto translate-y-6 transition duration-700 group-hover:translate-y-0 sm:h-80" />
    </a>
  </section>

  {reviews && reviews.reviews.length > 0 && (
    <section class="py-20 sm:py-28">
      <div class="container-x">
        <h2 class="t-section text-center">{c.reviewsTitle}</h2>
        {reviews.rating && <p class="mt-4 text-center text-xl text-muted">★ {reviews.rating.toFixed(1)} · {reviews.total} Google</p>}
        <div class="mt-12 flex snap-x gap-4 overflow-x-auto pb-4">
          {reviews.reviews.map((review) => (
            <figure class="w-[85%] shrink-0 snap-start rounded-[2rem] bg-mist p-8 sm:w-[24rem]">
              <p class="text-amber-500" aria-label={`${review.rating}/5`}>{'★'.repeat(Math.round(review.rating))}</p>
              <blockquote class="mt-3 text-lg leading-relaxed">{review.text}</blockquote>
              <figcaption class="mt-5 text-sm text-muted">{review.author} · {review.time}</figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-6 text-center"><a href={GOOGLE_PROFILE_URL} target="_blank" rel="noopener" class="more">{c.reviewsLink}</a></p>
      </div>
    </section>
  )}

  <!-- 6 · CIERRE ------------------------------------------------------------ -->
  <div class="pt-16 sm:pt-24"></div>
  <FinalCta lang={lang} location="home-final" />
</Base>

<style>
  .report .bar { width: 0; transition: width 1.2s cubic-bezier(0.3, 0.7, 0.2, 1); }
  .report.is-in .bar, .no-js .report .bar { width: var(--w); }
</style>
