---
/**
 * Portada. Seis pantallas, una idea por pantalla (estilo Apple):
 *   1. Que hacemos (hero)          4. Como funciona
 *   2. Pozo o ciudad               5. Por que nosotros
 *   3. Chequeo de agua             6. Cierre
 * Todo lo demas (servicios, zonas, financiamiento, preguntas) vive en su
 * propia pagina y en el pie.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import WaterCheck from '../components/WaterCheck.astro';
import FinalCta from '../components/FinalCta.astro';
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import { pathFor, STATIC_ROUTES } from '../i18n/routes';
import { getReviews } from '../lib/reviews';
import familyPhoto from '../assets/photos/family.png';
import {
  FOUNDER_YEARS,
  GOOGLE_PROFILE_URL,
  MADE_IN_USA,
  SEALS,
  WARRANTY,
  WHATSAPP_MESSAGE,
  whatsappUrl,
} from '../config/business';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';
const ui = t(lang);
const link = (key: string) => pathFor(key, lang);
const reviews = await getReviews(lang);
const seals = SEALS.filter((seal) => seal.enabled);

const c = es
  ? {
      metaTitle: 'Infinity Water | Análisis de agua gratis en Fort Myers y SW Florida',
      metaDescription: `Especialistas en agua de pozo y de ciudad en Fort Myers, Cape Coral, Lehigh Acres y Naples. Análisis gratis en tu casa, en español y sin presión. ${FOUNDER_YEARS}+ años de experiencia.`,
      eyebrow: 'Análisis de agua gratis en tu casa',
      titleA: 'Agua limpia.',
      titleB: 'Sin dudas.',
      lead: 'Medimos el agua de tu casa y te decimos la verdad. Gratis y en español.',
      report: 'Ejemplo de análisis',
      rows: [
        { label: 'Azufre', value: 'Alto', tone: 'bad' },
        { label: 'Hierro', value: 'Alto', tone: 'bad' },
        { label: 'Dureza', value: 'Media', tone: 'mid' },
        { label: 'pH', value: 'Normal', tone: 'ok' },
      ],
      well: { eyebrow: 'Agua de pozo', title: 'Nuestra especialidad.', text: 'Azufre, hierro, dureza. Lo resolvemos.' },
      city: { eyebrow: 'Agua de ciudad', title: 'Sin cloro. Sin exagerar.', text: 'Y si no necesitas nada, te lo decimos.' },
      more: 'Más información',
      howTitle: 'Así de simple.',
      steps: [
        { title: 'Escríbenos.', text: 'Por WhatsApp o teléfono. Agendamos cuando te convenga.' },
        { title: 'Medimos.', text: 'En tu casa, gratis. Te explicamos cada resultado.' },
        { title: 'Tú decides.', text: 'Sin presión. Y por ley, 3 días para cancelar.' },
      ],
      whyTitle: 'Por qué Infinity Water.',
      stats: [
        { big: `${FOUNDER_YEARS}+`, text: 'años de experiencia de nuestro fundador.' },
        ...(MADE_IN_USA ? [{ big: 'EE. UU.', text: 'Equipos fabricados en Estados Unidos.' }] : []),
        { big: 'Español', text: 'De la primera llamada al último papel.' },
      ],
      extras: [
        { icon: 'ShieldCheck', text: WARRANTY.es.short, href: link('about') },
        { icon: 'CreditCard', text: 'Financiamiento disponible', href: link('financing') },
      ],
      reviewsTitle: 'Lo que dicen nuestros clientes.',
      reviewsLink: 'Ver todas en Google',
    }
  : {
      metaTitle: 'Infinity Water | Free Water Test in Fort Myers & SW Florida',
      metaDescription: `Well and city water specialists in Fort Myers, Cape Coral, Lehigh Acres and Naples. Free in-home water test, no pressure, English or Spanish. ${FOUNDER_YEARS}+ years of experience.`,
      eyebrow: 'Free in-home water test',
      titleA: 'Clean water.',
      titleB: 'No guesswork.',
      lead: 'We test your home’s water and tell you the truth. Free.',
      report: 'Sample water test',
      rows: [
        { label: 'Sulfur', value: 'High', tone: 'bad' },
        { label: 'Iron', value: 'High', tone: 'bad' },
        { label: 'Hardness', value: 'Medium', tone: 'mid' },
        { label: 'pH', value: 'Normal', tone: 'ok' },
      ],
      well: { eyebrow: 'Well water', title: 'Our specialty.', text: 'Sulfur, iron, hardness. Solved.' },
      city: { eyebrow: 'City water', title: 'No chlorine. No upsell.', text: 'If you don’t need anything, we’ll say so.' },
      more: 'Learn more',
      howTitle: 'It’s that simple.',
      steps: [
        { title: 'Reach out.', text: 'WhatsApp or call. We schedule when it suits you.' },
        { title: 'We test.', text: 'At your home, free. We explain every result.' },
        { title: 'You decide.', text: 'No pressure. And by law, 3 days to cancel.' },
      ],
      whyTitle: 'Why Infinity Water.',
      stats: [
        { big: `${FOUNDER_YEARS}+`, text: 'years of our founder’s experience.' },
        ...(MADE_IN_USA ? [{ big: 'USA', text: 'Equipment made in the United States.' }] : []),
        { big: 'Bilingual', text: 'English or Spanish, start to finish.' },
      ],
      extras: [
        { icon: 'ShieldCheck', text: WARRANTY.en.short, href: link('about') },
        { icon: 'CreditCard', text: 'Financing available', href: link('financing') },
      ],
      reviewsTitle: 'What our customers say.',
      reviewsLink: 'See all on Google',
    };

const tone = { bad: 'bg-[#ff6b4a]', mid: 'bg-[#f5b400]', ok: 'bg-[#34c759]' } as const;
---

<Base lang={lang} title={c.metaTitle} description={c.metaDescription} paths={STATIC_ROUTES.home}>
  <!-- 1 · HERO ---------------------------------------------------------- -->
  <section class="overflow-hidden pt-14 text-center sm:pt-20">
    <div class="container-x">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="t-hero mt-3">
        {c.titleA}<br /><span class="text-gradient">{c.titleB}</span>
      </h1>
      <p class="t-lead mx-auto mt-6 max-w-2xl">{c.lead}</p>
      <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-8">
        <a href={link('freeWaterTest')} class="btn btn-primary !min-h-13 !px-8 !text-lg" data-track="free_test_cta" data-location="hero">{ui.cta.freeTest}</a>
        <a href={whatsappUrl(WHATSAPP_MESSAGE[lang])} target="_blank" rel="noopener" class="more !text-lg" data-track="whatsapp" data-location="hero">{ui.cta.whatsapp}</a>
      </div>
    </div>

    <div class="container-wide relative mt-14 sm:mt-20">
      <Image
        src={familyPhoto}
        alt={es ? 'Familia con un vaso de agua limpia en casa' : 'Family with a glass of clean water at home'}
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 1320px) 1280px, 96vw"
        class="aspect-[4/5] w-full rounded-[2rem] object-cover object-[60%_center] sm:aspect-[16/9] sm:rounded-[2.5rem]"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Tarjeta de analisis: explica en un vistazo que hacemos -->
      <div class="absolute bottom-6 left-1/2 w-[82%] max-w-[20rem] -translate-x-1/2 rounded-3xl bg-white/90 p-5 text-left shadow-lift backdrop-blur-xl sm:bottom-10 sm:left-auto sm:right-16 sm:translate-x-0 motion-safe:animate-float">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted">{c.report}</p>
        <ul class="mt-3 divide-y divide-black/5">
          {c.rows.map((row) => (
            <li class="flex items-center justify-between py-2.5 text-[0.95rem]">
              <span class="font-medium">{row.label}</span>
              <span class="flex items-center gap-2 font-semibold">
                <span class:list={['h-2 w-2 rounded-full', tone[row.tone as keyof typeof tone]]}></span>{row.value}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 2 · POZO O CIUDAD -------------------------------------------------- -->
  <section class="container-wide mt-4 grid gap-4 pb-4 pt-20 sm:pt-28 lg:grid-cols-2">
    <a href={link('well-water')} class="reveal group flex min-h-[30rem] flex-col items-center rounded-[2rem] bg-night px-8 pb-10 pt-14 text-center text-white sm:min-h-[36rem] sm:rounded-[2.5rem]">
      <p class="text-lg font-semibold text-[#5ec2ff]">{c.well.eyebrow}</p>
      <h2 class="mt-2 text-4xl sm:text-5xl">{c.well.title}</h2>
      <p class="mt-3 text-lg text-white/70 sm:text-xl">{c.well.text}</p>
      <span class="more mt-5 !text-[#5ec2ff]">{c.more}</span>
      <div class="mt-auto pt-10" aria-hidden="true">
        <svg viewBox="0 0 200 200" class="h-40 w-40 transition duration-700 group-hover:scale-105 sm:h-52 sm:w-52">
          <defs>
            <linearGradient id="drop-a" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8b5cf6" /><stop offset="1" stop-color="#16b3d4" /></linearGradient>
          </defs>
          <path d="M100 18C100 18 42 88 42 128a58 58 0 0 0 116 0C158 88 100 18 100 18z" fill="url(#drop-a)" />
          <path d="M74 132a28 28 0 0 0 26 26" stroke="white" stroke-opacity=".55" stroke-width="6" fill="none" stroke-linecap="round" />
        </svg>
      </div>
    </a>
    <a href={link('city-water')} class="reveal group flex min-h-[30rem] flex-col items-center rounded-[2rem] bg-mist px-8 pb-10 pt-14 text-center sm:min-h-[36rem] sm:rounded-[2.5rem]">
      <p class="text-lg font-semibold text-accent">{c.city.eyebrow}</p>
      <h2 class="mt-2 text-4xl sm:text-5xl">{c.city.title}</h2>
      <p class="mt-3 text-lg text-muted sm:text-xl">{c.city.text}</p>
      <span class="more mt-5">{c.more}</span>
      <div class="mt-auto pt-10" aria-hidden="true">
        <svg viewBox="0 0 200 200" class="h-40 w-40 transition duration-700 group-hover:scale-105 sm:h-52 sm:w-52">
          <defs>
            <linearGradient id="glass-a" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#cfeaf7" /><stop offset="1" stop-color="#16b3d4" /></linearGradient>
          </defs>
          <path d="M52 30h96l-12 146a10 10 0 0 1-10 9H74a10 10 0 0 1-10-9z" fill="white" stroke="#d2d2d7" stroke-width="3" />
          <path d="M60 80h80l-8 92a8 8 0 0 1-8 7H76a8 8 0 0 1-8-7z" fill="url(#glass-a)" />
          <circle cx="92" cy="120" r="5" fill="white" fill-opacity=".7" /><circle cx="110" cy="146" r="3.5" fill="white" fill-opacity=".7" /><circle cx="102" cy="100" r="3" fill="white" fill-opacity=".7" />
        </svg>
      </div>
    </a>
  </section>

  <!-- 3 · CHEQUEO -------------------------------------------------------- -->
  <WaterCheck lang={lang} />

  <!-- 4 · COMO FUNCIONA -------------------------------------------------- -->
  <section class="bg-mist py-24 sm:py-32">
    <div class="container-x">
      <h2 class="t-section reveal text-center">{c.howTitle}</h2>
      <ol class="mt-16 grid gap-12 sm:grid-cols-3 sm:gap-8">
        {c.steps.map((step, i) => (
          <li class="reveal text-center sm:text-left">
            <span class="text-gradient text-6xl font-bold tracking-tight sm:text-7xl">{i + 1}</span>
            <h3 class="mt-4 text-2xl sm:text-3xl">{step.title}</h3>
            <p class="mt-2 text-lg text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5 · POR QUE NOSOTROS ----------------------------------------------- -->
  <section class="py-24 sm:py-32">
    <div class="container-x">
      <h2 class="t-section reveal text-center">{c.whyTitle}</h2>
      <div class="mt-16 grid gap-4 sm:grid-cols-3">
        {c.stats.map((stat) => (
          <div class="reveal rounded-[2rem] bg-mist px-8 py-12 text-center">
            <p class="text-gradient text-5xl font-bold tracking-tight sm:text-6xl">{stat.big}</p>
            <p class="mt-4 text-lg text-muted">{stat.text}</p>
          </div>
        ))}
      </div>

      <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-5 text-[1.02rem]">
        {seals.map((seal) => (
          <span class="flex items-center gap-3"><img src={seal.image} alt="" width="44" height="44" class="h-11 w-auto" loading="lazy" />{seal.label[lang]}</span>
        ))}
        {c.extras.map((extra) => (
          <a href={extra.href} class="flex items-center gap-2 hover:text-accent"><Icon name={extra.icon} class="h-5 w-5 text-accent" />{extra.text}</a>
        ))}
      </div>
    </div>
  </section>

  {reviews && reviews.reviews.length > 0 && (
    <section class="bg-mist py-24 sm:py-32">
      <div class="container-x">
        <h2 class="t-section reveal text-center">{c.reviewsTitle}</h2>
        {reviews.rating && (
          <p class="mt-4 text-center text-xl text-muted">★ {reviews.rating.toFixed(1)} · {reviews.total} Google</p>
        )}
        <div class="mt-12 flex snap-x gap-4 overflow-x-auto pb-4">
          {reviews.reviews.map((review) => (
            <figure class="w-[85%] shrink-0 snap-start rounded-[2rem] bg-white p-8 sm:w-[24rem]">
              <p class="text-amber-500" aria-label={`${review.rating}/5`}>{'★'.repeat(Math.round(review.rating))}</p>
              <blockquote class="mt-3 text-lg leading-relaxed">{review.text}</blockquote>
              <figcaption class="mt-5 text-sm text-muted">{review.author} · {review.time}</figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-6 text-center"><a href={GOOGLE_PROFILE_URL} target="_blank" rel="noopener" class="more">{c.reviewsLink}</a></p>
      </div>
    </section>
  )}

  <!-- 6 · CIERRE --------------------------------------------------------- -->
  <FinalCta lang={lang} location="home-final" />
</Base>
