  </div>
</section>

<!-- ======================== FINANCIAMIENTO ======================= -->
<section class="px-4 sm:px-6">
  <div class="mx-auto grid max-w-7xl items-center gap-8 overflow-hidden rounded-5xl bg-gradient-to-br from-violet-soft via-white to-aqua-soft p-8 sm:p-14 lg:grid-cols-[auto_1fr_auto]">
