---
/**
 * Portada: "El agua, revelada".
 *
 *  1. Historia (WaterStory): el vaso cambia con cada problema hasta quedar
 *     cristalino. Explica el proposito del negocio sin leer.
 *  2. El analisis: que pasa cuando nos llamas (1-2-3) + tarjeta de resultado.
 *  3. Pozo o ciudad: las dos puertas de entrada.
 *  4. Chequeo de agua: la respuesta a "¿y lo mio que es?".
 *  5. Por que nosotros: tres cifras.
 *  6. Cierre.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import WaterStory from '../components/WaterStory.astro';
import WaterGlass from '../components/WaterGlass.astro';
import WaterCheck from '../components/WaterCheck.astro';
import FinalCta from '../components/FinalCta.astro';
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import { pathFor, STATIC_ROUTES } from '../i18n/routes';
import { getReviews } from '../lib/reviews';
import { FOUNDER_YEARS, GOOGLE_PROFILE_URL, MADE_IN_USA, SEALS, WARRANTY } from '../config/business';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';
const ui = t(lang);
const link = (key: string) => pathFor(key, lang);
const reviews = await getReviews(lang);
const seals = SEALS.filter((seal) => seal.enabled);

const c = es
  ? {
      metaTitle: 'Infinity Water | Análisis de agua gratis en Fort Myers y SW Florida',
      metaDescription: `Especialistas en agua de pozo y de ciudad en Fort Myers, Cape Coral, Lehigh Acres y Naples. Análisis gratis en tu casa, en español y sin presión. ${FOUNDER_YEARS}+ años de experiencia.`,
      testEyebrow: 'El análisis',
      testTitle: 'Primero, lo medimos. Gratis.',
      testLead: 'Vamos a tu casa, medimos tu agua y te explicamos cada resultado. Si no necesitas nada, te lo decimos.',
      steps: [
        { title: 'Escríbenos', text: 'Por WhatsApp o teléfono, en español.' },
        { title: 'Medimos en tu casa', text: 'Sin costo y sin compromiso.' },
        { title: 'Tú decides', text: 'Sin presión. Por ley, 3 días para cancelar.' },
      ],
      report: {
        title: 'Tu resultado',
        sub: 'Ejemplo · agua de pozo',
        rows: [
          { label: 'Azufre', value: 'Alto', level: 82, tone: 'bad' },
          { label: 'Hierro', value: 'Alto', level: 70, tone: 'bad' },
          { label: 'Dureza', value: 'Media', level: 48, tone: 'mid' },
          { label: 'pH', value: 'Normal', level: 34, tone: 'ok' },
        ],
        verdict: 'Recomendación: inyección de aire + filtro de hierro.',
      },
      well: { eyebrow: 'Agua de pozo', title: 'Nuestra especialidad.', text: 'Azufre, hierro y dureza, resueltos a la medida de tu pozo.' },
      city: { eyebrow: 'Agua de ciudad', title: 'Adiós al sabor a cloro.', text: 'Y si tu agua está bien, te lo decimos.' },
      more: 'Más información',
      whyTitle: 'Una familia que conoce tu agua.',
      stats: [
        { big: `${FOUNDER_YEARS}+`, text: 'años de experiencia de nuestro fundador' },
        ...(MADE_IN_USA ? [{ big: 'EE. UU.', text: 'equipos fabricados en Estados Unidos' }] : []),
        { big: 'Español', text: 'de la primera llamada al último papel' },
      ],
      extras: [
        { icon: 'ShieldCheck', text: WARRANTY.es.short, href: link('about') },
        { icon: 'CreditCard', text: 'Financiamiento disponible', href: link('financing') },
      ],
      reviewsTitle: 'Lo que dicen nuestros clientes.',
      reviewsLink: 'Ver todas en Google',
    }
  : {
      metaTitle: 'Infinity Water | Free Water Test in Fort Myers & SW Florida',
      metaDescription: `Well and city water specialists in Fort Myers, Cape Coral, Lehigh Acres and Naples. Free in-home water test, no pressure, English or Spanish. ${FOUNDER_YEARS}+ years of experience.`,
      testEyebrow: 'The water test',
      testTitle: 'First, we test it. Free.',
      testLead: 'We come to your home, test your water and explain every result. If you don’t need anything, we’ll tell you.',
      steps: [
        { title: 'Reach out', text: 'WhatsApp or call, English or Spanish.' },
        { title: 'We test at home', text: 'No cost, no obligation.' },
        { title: 'You decide', text: 'No pressure. By law, 3 days to cancel.' },
      ],
      report: {
        title: 'Your result',
        sub: 'Sample · well water',
        rows: [
          { label: 'Sulfur', value: 'High', level: 82, tone: 'bad' },
          { label: 'Iron', value: 'High', level: 70, tone: 'bad' },
          { label: 'Hardness', value: 'Medium', level: 48, tone: 'mid' },
          { label: 'pH', value: 'Normal', level: 34, tone: 'ok' },
        ],
        verdict: 'Recommendation: air injection + iron filter.',
      },
      well: { eyebrow: 'Well water', title: 'Our specialty.', text: 'Sulfur, iron and hardness, solved for your well.' },
      city: { eyebrow: 'City water', title: 'Goodbye, chlorine taste.', text: 'And if your water is fine, we’ll tell you.' },
      more: 'Learn more',
      whyTitle: 'A family that knows your water.',
      stats: [
        { big: `${FOUNDER_YEARS}+`, text: 'years of our founder’s experience' },
        ...(MADE_IN_USA ? [{ big: 'USA', text: 'equipment made in the United States' }] : []),
        { big: 'Bilingual', text: 'English or Spanish, start to finish' },
      ],
      extras: [
        { icon: 'ShieldCheck', text: WARRANTY.en.short, href: link('about') },
        { icon: 'CreditCard', text: 'Financing available', href: link('financing') },
      ],
      reviewsTitle: 'What our customers say.',
      reviewsLink: 'See all on Google',
    };

const tone = { bad: '#ff6b4a', mid: '#f5b400', ok: '#34c759' } as const;
---

<Base lang={lang} title={c.metaTitle} description={c.metaDescription} paths={STATIC_ROUTES.home} flush>
  <!-- 1 · HISTORIA ------------------------------------------------------- -->
  <WaterStory lang={lang} />

  <!-- 2 · EL ANALISIS ---------------------------------------------------- -->
  <section class="py-24 sm:py-36">
    <div class="container-x grid items-center gap-14 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
      <div>
        <p class="eyebrow reveal">{c.testEyebrow}</p>
        <h2 class="t-section reveal mt-2">{c.testTitle}</h2>
        <p class="t-lead reveal mt-6 max-w-xl">{c.testLead}</p>
        <ol class="mt-10 space-y-6">
          {c.steps.map((step, i) => (
            <li class="reveal flex items-start gap-5">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-mist text-lg font-bold text-accent">{i + 1}</span>
              <span>
                <span class="block text-xl font-semibold tracking-tight">{step.title}</span>
                <span class="block text-lg text-muted">{step.text}</span>
              </span>
            </li>
          ))}
        </ol>
        <a href={link('freeWaterTest')} class="btn btn-primary reveal mt-10 !min-h-13 !px-8 !text-lg" data-track="free_test_cta" data-location="test-section">{ui.cta.freeTest}</a>
      </div>

      <!-- Tarjeta de resultado: las barras se llenan al entrar en pantalla -->
      <div class="reveal report mx-auto w-full max-w-md rounded-[2.25rem] bg-mist p-3">
        <div class="rounded-[1.8rem] bg-white p-7 shadow-soft sm:p-9">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-2xl font-bold tracking-tight">{c.report.title}</p>
              <p class="text-sm text-muted">{c.report.sub}</p>
            </div>
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-mist"><Icon name="FlaskConical" class="h-6 w-6 text-accent" /></span>
          </div>
          <ul class="mt-8 space-y-6">
            {c.report.rows.map((row, i) => (
              <li>
                <div class="flex justify-between text-[1.02rem]"><span class="font-medium">{row.label}</span><span class="font-semibold" style={`color:${tone[row.tone as keyof typeof tone]}`}>{row.value}</span></div>
                <div class="mt-2 h-2 overflow-hidden rounded-full bg-mist">
                  <div class="bar h-full rounded-full" style={`--w:${row.level}%;background:${tone[row.tone as keyof typeof tone]};transition-delay:${0.25 + i * 0.12}s`}></div>
                </div>
              </li>
            ))}
          </ul>
          <p class="mt-8 flex items-start gap-2 rounded-2xl bg-mist p-4 text-[0.95rem] font-medium"><Icon name="CircleCheck" class="mt-0.5 h-5 w-5 shrink-0 text-accent" />{c.report.verdict}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 · POZO O CIUDAD -------------------------------------------------- -->
  <section class="container-wide grid gap-4 pb-4 lg:grid-cols-2">
    <a href={link('well-water')} data-nav="dark" class="reveal group relative flex min-h-[34rem] flex-col items-center overflow-hidden rounded-[2rem] bg-black px-8 pt-14 text-center text-white sm:min-h-[40rem] sm:rounded-[2.5rem]" data-water="iron">
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-[radial-gradient(50%_60%_at_50%_85%,rgb(194_88_31/0.35),transparent)]"></div>
      <p class="relative text-lg font-semibold text-[#5ec2ff]">{c.well.eyebrow}</p>
      <h2 class="t-title relative mt-2 !text-[clamp(2rem,1.2rem+2.4vw,3.4rem)]">{c.well.title}</h2>
      <p class="relative mt-3 max-w-sm text-lg text-white/70">{c.well.text}</p>
      <span class="more relative mt-5 !text-[#5ec2ff]">{c.more}</span>
      <WaterGlass id="tile-well" class="relative mt-auto h-64 w-auto translate-y-6 transition duration-700 group-hover:-translate-y-0 sm:h-80" />
    </a>
    <a href={link('city-water')} class="reveal group relative flex min-h-[34rem] flex-col items-center overflow-hidden rounded-[2rem] bg-mist px-8 pt-14 text-center sm:min-h-[40rem] sm:rounded-[2.5rem]" data-water="clear">
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-2/3 bg-[radial-gradient(50%_60%_at_50%_85%,rgb(22_179_212/0.22),transparent)]"></div>
      <p class="relative text-lg font-semibold text-accent">{c.city.eyebrow}</p>
      <h2 class="t-title relative mt-2 !text-[clamp(2rem,1.2rem+2.4vw,3.4rem)]">{c.city.title}</h2>
      <p class="relative mt-3 max-w-sm text-lg text-muted">{c.city.text}</p>
      <span class="more relative mt-5">{c.more}</span>
      <WaterGlass id="tile-city" on="light" class="relative mt-auto h-64 w-auto translate-y-6 transition duration-700 group-hover:-translate-y-0 sm:h-80" />
    </a>
  </section>

  <!-- 4 · CHEQUEO -------------------------------------------------------- -->
  <WaterCheck lang={lang} />

  <!-- 5 · POR QUE NOSOTROS ----------------------------------------------- -->
  <section class="bg-mist py-24 sm:py-36">
    <div class="container-x">
      <h2 class="t-section reveal mx-auto max-w-3xl text-center">{c.whyTitle}</h2>
      <div class="mt-16 grid gap-4 md:grid-cols-3">
        {c.stats.map((stat) => (
          <div class="reveal rounded-[2rem] bg-white px-8 py-12 text-center">
            <p class="text-gradient text-[clamp(3rem,2rem+3vw,4.5rem)] font-bold leading-none tracking-tight">{stat.big}</p>
            <p class="mt-4 text-lg text-muted">{stat.text}</p>
          </div>
        ))}
      </div>
      <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-5 text-[1.02rem]">
        {seals.map((seal) => (
          <span class="flex items-center gap-3"><img src={seal.image} alt="" width="44" height="44" class="h-11 w-auto" loading="lazy" />{seal.label[lang]}</span>
        ))}
        {c.extras.map((extra) => (
          <a href={extra.href} class="flex items-center gap-2 hover:text-accent"><Icon name={extra.icon} class="h-5 w-5 text-accent" />{extra.text}</a>
        ))}
      </div>
    </div>
  </section>

  {reviews && reviews.reviews.length > 0 && (
    <section class="py-24 sm:py-32">
      <div class="container-x">
        <h2 class="t-section reveal text-center">{c.reviewsTitle}</h2>
        {reviews.rating && <p class="mt-4 text-center text-xl text-muted">★ {reviews.rating.toFixed(1)} · {reviews.total} Google</p>}
        <div class="mt-12 flex snap-x gap-4 overflow-x-auto pb-4">
          {reviews.reviews.map((review) => (
            <figure class="w-[85%] shrink-0 snap-start rounded-[2rem] bg-mist p-8 sm:w-[24rem]">
              <p class="text-amber-500" aria-label={`${review.rating}/5`}>{'★'.repeat(Math.round(review.rating))}</p>
              <blockquote class="mt-3 text-lg leading-relaxed">{review.text}</blockquote>
              <figcaption class="mt-5 text-sm text-muted">{review.author} · {review.time}</figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-6 text-center"><a href={GOOGLE_PROFILE_URL} target="_blank" rel="noopener" class="more">{c.reviewsLink}</a></p>
      </div>
    </section>
  )}

  <!-- 6 · CIERRE --------------------------------------------------------- -->
  <FinalCta lang={lang} location="home-final" />
</Base>

<style>
  .report .bar { width: 0; transition: width 1.2s cubic-bezier(0.3, 0.7, 0.2, 1); }
  .report.is-in .bar, .no-js .report .bar { width: var(--w); }
</style>
