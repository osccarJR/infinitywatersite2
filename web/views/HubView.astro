---
/** Indices de servicios (/services) y de zonas (/areas): mosaico de tarjetas. */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import FinalCta from '../components/FinalCta.astro';
import type { Lang } from '../data/types';
import { contentPath, pagesOfKind, STATIC_ROUTES } from '../i18n/routes';
import { labelOf } from '../data/labels';
import { OTHER_FLORIDA, WHATSAPP_MESSAGE, whatsappUrl } from '../config/business';

interface Props {
  lang: Lang;
  hub: 'services' | 'areas';
}

const { lang, hub } = Astro.props;
const es = lang === 'es';
const pages = pagesOfKind(hub === 'services' ? 'service' : 'city');
const problems = pagesOfKind('problem');

const c =
  hub === 'services'
    ? es
      ? {
          metaTitle: 'Servicios de tratamiento de agua | Infinity Water',
          metaDescription: 'Filtración para toda la casa, sistemas para agua de pozo, ósmosis inversa y mantenimiento en Fort Myers, Cape Coral, Lehigh Acres y Naples. Equipos hechos en EE. UU.',
          eyebrow: 'Servicios',
          title: 'Un sistema para cada agua.',
          lead: 'Primero la medimos. Después, solo lo que necesitas.',
          extraTitle: '¿Tienes un problema concreto?',
        }
      : {
          metaTitle: 'Water Treatment Services | Infinity Water',
          metaDescription: 'Whole-house filtration, well water systems, reverse osmosis and maintenance in Fort Myers, Cape Coral, Lehigh Acres and Naples. Made in USA equipment.',
          eyebrow: 'Services',
          title: 'A system for every water.',
          lead: 'We test it first. Then only what you need.',
          extraTitle: 'Dealing with a specific problem?',
        }
    : es
      ? {
          metaTitle: 'Zonas de servicio en el suroeste de Florida | Infinity Water',
          metaDescription: 'Atendemos Fort Myers, Cape Coral, Lehigh Acres, Naples, Golden Gate Estates, Bonita Springs y Estero. Conoce el agua de tu zona con datos oficiales.',
          eyebrow: 'Zonas',
          title: 'Conocemos el agua de tu zona.',
          lead: 'Cada ciudad es distinta. Mira qué dicen sus datos oficiales.',
          extraTitle: 'También llegamos a',
        }
      : {
          metaTitle: 'Service Areas in Southwest Florida | Infinity Water',
          metaDescription: 'We serve Fort Myers, Cape Coral, Lehigh Acres, Naples, Golden Gate Estates, Bonita Springs and Estero. Learn about your area’s water with official data.',
          eyebrow: 'Service areas',
          title: 'We know the water where you live.',
          lead: 'Every city is different. See what the official data says.',
          extraTitle: 'We also serve',
        };
---

<Base lang={lang} title={c.metaTitle} description={c.metaDescription} paths={STATIC_ROUTES[hub]}>
  <header class="pb-16 pt-16 text-center sm:pt-24">
    <div class="container-x">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1 class="t-hero mx-auto mt-3 max-w-4xl !text-[2.6rem] sm:!text-6xl lg:!text-7xl">{c.title}</h1>
      <p class="t-lead mx-auto mt-6 max-w-2xl">{c.lead}</p>
    </div>
  </header>

  <section class:list={['container-wide grid gap-4 pb-24 sm:grid-cols-2', hub === 'services' ? 'xl:grid-cols-4' : 'lg:grid-cols-3']}>
    {pages.map((page, i) => (
      <a
        href={contentPath(page, lang)}
        class:list={[
          'reveal group flex min-h-[22rem] flex-col rounded-[2rem] p-9 transition sm:rounded-[2.5rem]',
          hub === 'services' && i === 1 ? 'bg-night text-white' : 'bg-mist hover:bg-[#ebebef]',
          hub === 'services' && 'lg:col-span-1',
        ]}
      >
        <Icon name={hub === 'areas' ? 'MapPin' : page.icon} class:list={['h-9 w-9', hub === 'services' && i === 1 ? 'text-[#5ec2ff]' : 'text-accent']} strokeWidth={1.5} />
        <p class:list={['mt-auto pt-10 text-sm font-semibold', hub === 'services' && i === 1 ? 'text-white/60' : 'text-muted']}>{page[lang].eyebrow}</p>
        <h2 class="mt-1 text-3xl">{labelOf(page, lang)}</h2>
        <p class:list={['mt-3 text-lg leading-snug', hub === 'services' && i === 1 ? 'text-white/70' : 'text-muted']}>{page[lang].lead}</p>
        <span class:list={['more mt-5', hub === 'services' && i === 1 && '!text-[#5ec2ff]']}>{es ? 'Más información' : 'Learn more'}</span>
      </a>
    ))}
    {hub === 'areas' && (
      <a href={whatsappUrl(WHATSAPP_MESSAGE[lang])} target="_blank" rel="noopener" class="reveal flex min-h-[22rem] flex-col rounded-[2rem] bg-night p-9 text-white sm:rounded-[2.5rem]" data-track="whatsapp" data-location="areas-other">
        <Icon name="MessageCircle" class="h-9 w-9 text-[#5ec2ff]" strokeWidth={1.5} />
        <h2 class="mt-auto pt-10 text-3xl">{es ? '¿Tu zona no aparece?' : 'Don’t see your area?'}</h2>
        <p class="mt-3 text-lg leading-snug text-white/70">{es ? 'Escríbenos por WhatsApp y te decimos si llegamos.' : 'Message us on WhatsApp and we’ll tell you if we can come.'}</p>
        <span class="more mt-5 !text-[#5ec2ff]">WhatsApp</span>
      </a>
    )}
  </section>

  <section class="bg-mist py-20 text-center">
    <div class="container-x">
      <h2 class="text-3xl sm:text-4xl">{c.extraTitle}</h2>
      {hub === 'services' ? (
        <ul class="mt-8 flex flex-wrap justify-center gap-3">
          {problems.map((page) => (
            <li><a href={contentPath(page, lang)} class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 font-medium hover:text-accent"><Icon name={page.icon} class="h-5 w-5 text-accent" />{labelOf(page, lang)}</a></li>
          ))}
        </ul>
      ) : (
        <p class="mx-auto mt-6 max-w-2xl text-xl text-muted">{OTHER_FLORIDA.join(' · ')}</p>
      )}
    </div>
  </section>

  <FinalCta lang={lang} location={`${hub}-hub`} />
</Base>
