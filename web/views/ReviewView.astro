---
/**
 * Resenas.
 *
 *  - variant 'page' (/es/resena): lo que ve el cliente al escanear el QR o
 *    abrir el enlace que le mandamos por WhatsApp. Un solo boton grande.
 *  - variant 'card' (/es/tarjeta-resena): tarjeta imprimible con QR para
 *    que el tecnico la muestre o la deje al terminar cada visita.
 *
 * Regla FTC (16 CFR 465, 2024): se pide la resena a TODOS los clientes, sin
 * filtrar a los contentos ("review gating") y sin incentivos a cambio de
 * resenas positivas. Por eso aqui no hay preguntas previas del tipo
 * "¿quedaste satisfecho?" que desvien a los descontentos.
 */
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import type { Lang } from '../data/types';
import { STATIC_ROUTES } from '../i18n/routes';
import { REVIEW_URL, SITE_URL, WHATSAPP_MESSAGE, whatsappUrl } from '../config/business';

interface Props {
  lang: Lang;
  variant: 'page' | 'card';
}

const { lang, variant } = Astro.props;
const es = lang === 'es';

// El QR apunta a nuestra pagina de resena (no a Google): si cambia el
// destino, las tarjetas impresas siguen sirviendo.
const reviewPageUrl = `${SITE_URL}${STATIC_ROUTES.review[lang]}`;
const qr = await QRCode.toString(reviewPageUrl, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1d1d1fff', light: '#ffffff00' } });

const c = es
  ? {
      title: 'Déjanos tu reseña | Infinity Water',
      description: 'Cuéntale a otras familias cómo te fue con Infinity Water. Te toma un minuto.',
      h1: '¿Cómo te fue con nosotros?',
      lead: 'Tu opinión ayuda a otras familias de la zona a decidir con confianza. Te toma un minuto.',
      button: 'Escribir mi reseña en Google',
      tipsTitle: 'Si quieres, cuéntanos:',
      tips: ['Qué problema tenía tu agua', 'En qué ciudad vives', 'Cómo te atendimos'],
      thanks: 'Gracias por confiar en nuestra familia.',
      help: '¿Necesitas ayuda con tu sistema? Escríbenos por WhatsApp',
      cardTitle: '¿Te gustó el servicio?',
      cardText: 'Escanea el código y déjanos tu reseña en Google. Nos ayuda muchísimo.',
      cardOr: 'o entra a',
      print: 'Imprimir tarjeta',
      printHint: 'Se imprimen 4 tarjetas por hoja. Recórtalas por la línea.',
    }
  : {
      title: 'Leave us a review | Infinity Water',
      description: 'Tell other families how your experience with Infinity Water went. It takes a minute.',
      h1: 'How did we do?',
      lead: 'Your review helps other local families decide with confidence. It takes a minute.',
      button: 'Write my Google review',
      tipsTitle: 'If you’d like, mention:',
      tips: ['What was wrong with your water', 'What city you live in', 'How we treated you'],
      thanks: 'Thank you for trusting our family.',
      help: 'Need help with your system? Message us on WhatsApp',
      cardTitle: 'Happy with our service?',
      cardText: 'Scan the code and leave us a Google review. It helps us a lot.',
      cardOr: 'or visit',
      print: 'Print card',
      printHint: 'Prints 4 cards per page. Cut along the line.',
    };

const shortUrl = reviewPageUrl.replace('https://', '');
---

<Base lang={lang} title={c.title} description={c.description} paths={variant === 'page' ? STATIC_ROUTES.review : STATIC_ROUTES.reviewCard} noindex minimal>
  {variant === 'page' ? (
    <section class="bg-gradient-to-b from-[#eef6fc] to-white py-16 sm:py-24">
      <div class="container-x max-w-xl text-center">
        <p class="text-4xl text-amber-400" aria-hidden="true">★★★★★</p>
        <h1 class="mt-5 text-[clamp(2.2rem,1.4rem+3vw,3.5rem)] leading-[1.05]">{c.h1}</h1>
        <p class="t-lead mt-5">{c.lead}</p>
        <a href={REVIEW_URL} target="_blank" rel="noopener" class="btn btn-primary mt-10 !min-h-16 w-full !text-lg" data-track="review_click" data-location="review-page">
          <Icon name="Star" />{c.button}
        </a>
        <div class="mt-10 rounded-3xl bg-mist p-6 text-left">
          <p class="font-semibold">{c.tipsTitle}</p>
          <ul class="mt-3 space-y-2">
            {c.tips.map((tip) => <li class="flex items-center gap-2 text-muted"><Icon name="CircleCheck" class="h-5 w-5 text-accent" />{tip}</li>)}
          </ul>
        </div>
        <p class="mt-10 text-lg font-semibold">{c.thanks}</p>
        <a href={whatsappUrl(WHATSAPP_MESSAGE[lang])} target="_blank" rel="noopener" class="more mt-3 !whitespace-normal !text-base" data-track="whatsapp" data-location="review-page">{c.help}</a>
      </div>
    </section>
  ) : (
    <section class="py-10 print:py-0">
      <h1 class="sr-only">{es ? 'Tarjeta para pedir reseñas' : 'Review request card'}</h1>
      <div class="container-x print:max-w-none print:px-0">
        <div class="mb-8 flex flex-col items-center gap-3 text-center print:hidden">
          <button type="button" class="btn btn-primary" onclick="window.print()"><Icon name="FileText" />{c.print}</button>
          <p class="text-sm text-muted">{c.printHint}</p>
        </div>
        <div class="cards mx-auto grid max-w-3xl gap-6 sm:grid-cols-2 print:gap-0">
          {[0, 1, 2, 3].map((i) => (
            <article class:list={['card-print flex flex-col items-center rounded-3xl border border-line p-7 text-center', i > 0 && 'hidden sm:flex print:flex']}>
              <img src="/images/logo-dark.webp" alt="Infinity Water" width="150" height="27" class="h-6 w-auto" />
              <p class="mt-4 text-2xl text-amber-400" aria-hidden="true">★★★★★</p>
              <h2 class="mt-2 text-2xl">{c.cardTitle}</h2>
              <p class="mt-2 text-[0.95rem] leading-snug text-muted">{c.cardText}</p>
              <div class="mt-5 h-40 w-40" set:html={qr} />
              <p class="mt-4 text-xs text-muted">{c.cardOr} <span class="font-semibold text-ink">{shortUrl}</span></p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  @media print {
    :global(#site-header), :global(footer), :global(#mobile-bar), :global(#lang-banner) { display: none !important; }
    :global(main) { padding-top: 0 !important; }
    .cards { grid-template-columns: 1fr 1fr; max-width: none; }
    .card-print { border-radius: 0; border-style: dashed; break-inside: avoid; min-height: 48vh; justify-content: center; }
  }
</style>
