---
/**
 * Paginas legales (privacidad, terminos, SMS). Rutas y texto en ingles
 * declarados en el registro A2P: el ingles NO se reescribe.
 *
 * En la ruta en espanol se muestra primero la traduccion y despues el texto
 * completo en ingles, porque la revision de la campana se hace en EE. UU. y
 * el revisor no tiene por que saber cambiar de idioma.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import type { Lang } from '../data/types';
import { pathFor, STATIC_ROUTES } from '../i18n/routes';
import { LEGAL_ENTITY_DBA } from '../config/business';
import { PRIVACY_POLICY } from '../data/legal/privacyPolicy';
import { TERMS } from '../data/legal/terms';
import { SMS_POLICY } from '../data/legal/smsPolicy';

type DocKey = 'privacy' | 'terms' | 'smsPolicy';
type LegalLink = { before: string; label: string; after: string };
type Section = {
  heading: string;
  paragraphs?: string[];
  items?: string[];
  address?: string[];
  termsLink?: LegalLink;
  smsPolicyLink?: LegalLink;
  privacyLink?: LegalLink;
};
type LegalDoc = { title: string; effectiveLabel: string; effectiveDate: string; intro: string; sections: Section[] };

interface Props {
  lang: Lang;
  doc: DocKey;
}

const { lang, doc } = Astro.props;
const docs = { privacy: PRIVACY_POLICY, terms: TERMS, smsPolicy: SMS_POLICY } as Record<DocKey, Record<Lang, LegalDoc>>;
const current = docs[doc][lang];
const english = docs[doc].en;

const descriptions: Record<DocKey, Record<Lang, string>> = {
  privacy: {
    en: 'How Infinity Water collects, uses and protects the personal information you share with us through this website, phone calls and WhatsApp.',
    es: 'Cómo Infinity Water recopila, usa y protege la información personal que compartes con nosotros a través de este sitio, llamadas y WhatsApp.',
  },
  terms: {
    en: `Terms governing the use of infinitywatersite.com and the Infinity Water SMS program operated by ${LEGAL_ENTITY_DBA}.`,
    es: `Términos que rigen el uso de infinitywatersite.com y el programa de SMS de Infinity Water, operado por ${LEGAL_ENTITY_DBA}.`,
  },
  smsPolicy: {
    en: 'How the Infinity Water text messaging program works: what we send, how often, how to reply STOP or HELP, and how your opt-in information is handled.',
    es: 'Cómo funciona el programa de mensajes de texto de Infinity Water: qué enviamos, con qué frecuencia, cómo responder STOP o HELP y cómo se trata tu opt-in.',
  },
};

const titles: Record<DocKey, Record<Lang, string>> = {
  privacy: { en: 'Privacy Policy | Infinity Water', es: 'Política de Privacidad | Infinity Water' },
  terms: { en: 'Terms & Conditions | Infinity Water', es: 'Términos y Condiciones | Infinity Water' },
  smsPolicy: { en: 'SMS Policy | Infinity Water', es: 'Política de SMS | Infinity Water' },
};

const es = lang === 'es';
const renderDocs = es ? [{ doc: current, linkLang: 'es' as Lang }, { doc: english, linkLang: 'en' as Lang, english: true }] : [{ doc: current, linkLang: 'en' as Lang }];
---

<Base lang={lang} title={titles[doc][lang]} description={descriptions[doc][lang]} paths={STATIC_ROUTES[doc]}>
  <div class="container-x max-w-3xl pb-24 pt-12 sm:pt-16">
    <a href={pathFor('home', lang)} class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline">
      <Icon name="ArrowLeft" class="h-4 w-4" />{es ? 'Volver al inicio' : 'Back to home'}
    </a>
    <p class="mt-8 flex items-center gap-3 text-sm text-muted">
      <span class="grid h-11 w-11 place-items-center rounded-2xl bg-foam"><Icon name="ShieldCheck" class="h-5 w-5 text-aqua-deep" /></span>
      {LEGAL_ENTITY_DBA}
    </p>

    {renderDocs.map(({ doc: d, linkLang, english: isEnglishCopy }) => (
      <article lang={isEnglishCopy ? 'en' : lang} class:list={['mt-8', isEnglishCopy && 'mt-20 border-t-2 border-ink/10 pt-12']}>
        {isEnglishCopy && (
          <div class="mb-10 rounded-3xl bg-foam p-5">
            <h2 class="text-lg font-semibold tracking-normal">Versión en inglés</h2>
            <p class="mt-1 text-sm text-muted">El texto en inglés que aparece a continuación es la versión oficial de este documento y se incluye para efectos de revisión.</p>
          </div>
        )}
        {isEnglishCopy ? <h2 class="text-3xl sm:text-4xl">{d.title}</h2> : <h1 class="text-4xl sm:text-5xl">{d.title}</h1>}
        <p class="mt-3 text-sm text-muted">{d.effectiveLabel}: {d.effectiveDate}</p>
        <p class="prose-iw mt-8">{d.intro}</p>

        <div class="mt-10 space-y-10">
          {d.sections.map((section) => (
            <section>
              <h3 class="text-2xl">{section.heading}</h3>
              <div class="prose-iw mt-3">
                {section.paragraphs?.map((p) => <p>{p}</p>)}
              </div>
              {section.items && (
                <ul class="prose-iw mt-3 list-disc space-y-1.5 pl-6">{section.items.map((item) => <li>{item}</li>)}</ul>
              )}
              {section.address && (
                <address class="mt-4 space-y-1 rounded-2xl border border-ink/10 bg-foam p-5 not-italic">
                  {section.address.map((line, i) => <p class:list={[i === 0 && 'font-bold']}>{line}</p>)}
                </address>
              )}
              {section.termsLink && (
                <p class="prose-iw mt-4">{section.termsLink.before}<a class="link" href={pathFor('terms', linkLang)}>{section.termsLink.label}</a>{section.termsLink.after}</p>
              )}
              {section.smsPolicyLink && (
                <p class="prose-iw mt-2">{section.smsPolicyLink.before}<a class="link" href={pathFor('smsPolicy', linkLang)}>{section.smsPolicyLink.label}</a>{section.smsPolicyLink.after}</p>
              )}
              {section.privacyLink && (
                <p class="prose-iw mt-2">{section.privacyLink.before}<a class="link" href={pathFor('privacy', linkLang)}>{section.privacyLink.label}</a>{section.privacyLink.after}</p>
              )}
            </section>
          ))}
        </div>
      </article>
    ))}
  </div>
</Base>
