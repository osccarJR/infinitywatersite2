---
/**
 * Barra global, al estilo de la de Apple: fina, translucida, pocos enlaces
 * y sin desplegables. Todo lo demas vive en el pie o dentro de cada pagina.
 * En movil abre un menu a pantalla completa con enlaces grandes.
 */
import Icon from './Icon.astro';
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import { pathFor, otherLang } from '../i18n/routes';

interface Props {
  lang: Lang;
  alternatePath: string;
  hideCta?: boolean;
}

const { lang, alternatePath, hideCta = false } = Astro.props;
const ui = t(lang);
const link = (key: string) => pathFor(key, lang);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
  { href: link('well-water'), label: ui.nav.wellWater },
  { href: link('city-water'), label: ui.nav.cityWater },
  { href: link('services'), label: ui.nav.services },
  { href: link('areas'), label: ui.nav.areas },
  { href: link('about'), label: ui.nav.about },
];
const mobileExtra = [
  { href: link('faq'), label: ui.nav.faq },
  { href: link('financing'), label: ui.nav.financing },
  { href: link('contact'), label: ui.nav.contact },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 bg-[#161617]/85 text-white backdrop-blur-xl backdrop-saturate-150">
  <div class="container-wide flex h-14 items-center gap-4">
    <a href={link('home')} class="shrink-0" aria-label="Infinity Water">
      <img src="/images/logo.webp" alt="Infinity Water" width="140" height="25" class="h-[22px] w-auto" />
    </a>

    <nav class="mx-auto hidden items-center gap-8 lg:flex" aria-label={ui.menu}>
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={['text-[0.82rem] transition hover:text-white', current === item.href ? 'text-white' : 'text-white/75']}
          aria-current={current === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-3 lg:ml-0">
      <a
        href={alternatePath}
        hreflang={otherLang(lang)}
        lang={otherLang(lang)}
        class="rounded-full px-2 py-1 text-[0.8rem] font-medium text-white/75 transition hover:text-white"
        aria-label={ui.langSwitchLabel}
      >
        {lang === 'es' ? 'English' : 'Español'}
      </a>
      {!hideCta && (
        <a href={link('freeWaterTest')} class="hidden rounded-full bg-accent px-4 py-1.5 text-[0.8rem] font-semibold text-white transition hover:bg-accent-hover sm:inline-flex" data-track="free_test_cta" data-location="header">
          {ui.cta.freeTestShort}
        </a>
      )}
      <button
        type="button"
        class="-mr-2 inline-flex h-10 w-10 items-center justify-center text-white/90 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label data-open={ui.menu} data-close={ui.close}>{ui.menu}</span>
        <span class="relative block h-3 w-[18px]" aria-hidden="true">
          <span class="bar absolute left-0 top-0 h-[1.5px] w-full rounded bg-current transition duration-300"></span>
          <span class="bar absolute bottom-0 left-0 h-[1.5px] w-full rounded bg-current transition duration-300"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Menu movil a pantalla completa -->
  <div id="mobile-menu" class="hidden h-[calc(100dvh-3.5rem)] overflow-y-auto bg-[#161617] lg:hidden">
    <nav class="container-wide pb-16 pt-6" aria-label={ui.menu}>
      <ul class="space-y-1">
        {nav.map((item) => (
          <li><a href={item.href} class="block py-2.5 text-[1.75rem] font-semibold tracking-tight text-white/90 hover:text-white">{item.label}</a></li>
        ))}
      </ul>
      <ul class="mt-8 space-y-1 border-t border-white/10 pt-6">
        {mobileExtra.map((item) => (
          <li><a href={item.href} class="block py-2 text-lg text-white/70 hover:text-white">{item.label}</a></li>
        ))}
      </ul>
      <a href={link('freeWaterTest')} class="btn btn-primary mt-10 w-full" data-track="free_test_cta" data-location="mobile-menu">{ui.cta.freeTest}</a>
    </nav>
  </div>
</header>

<style>
  [aria-expanded='true'] .bar:first-child { top: 50%; transform: translateY(-50%) rotate(45deg); }
  [aria-expanded='true'] .bar:last-child { bottom: 50%; transform: translateY(50%) rotate(-45deg); }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('hidden', !open);
    document.documentElement.classList.toggle('overflow-hidden', open);
    if (label) label.textContent = (open ? label.dataset.close : label.dataset.open) ?? '';
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') toggle.click();
  });
</script>
