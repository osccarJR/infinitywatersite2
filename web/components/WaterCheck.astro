---
/**
 * "Chequeo de agua": una sola interaccion. Control segmentado pozo/ciudad
 * y seis sintomas; al tocar uno aparece la respuesta al instante.
 *
 * Las respuestas se renderizan en el servidor (indexables y sin JS se ven
 * todas); el script solo muestra la elegida. NO pide datos personales: el
 * unico punto de captura del sitio es el formulario de GoHighLevel (A2P).
 */
import Icon from './Icon.astro';
import type { Lang } from '../data/types';
import { CONCERNS } from '../data/waterCheck';
import { pathFor } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const es = lang === 'es';
const formPath = pathFor('freeWaterTest', lang);

const c = {
  title: es ? '¿Qué notas en tu agua?' : 'What do you notice in your water?',
  sub: es ? 'Tócalo. Te decimos qué es.' : 'Tap it. We’ll tell you what it is.',
  well: es ? 'Pozo' : 'Well',
  city: es ? 'Ciudad' : 'City',
  sourceLabel: es ? 'Tu agua viene de' : 'Your water comes from',
  cta: es ? 'Confírmalo gratis' : 'Confirm it for free',
  more: es ? 'Más información' : 'Learn more',
  hint: es ? 'Elige una opción para ver la respuesta.' : 'Pick one to see the answer.',
};
---

<section id="chequeo" class="py-24 sm:py-32" data-water-check data-form={formPath}>
  <div class="container-x text-center">
    <h2 class="t-section reveal">{c.title}</h2>
    <p class="t-lead reveal mt-4">{c.sub}</p>

    <!-- Control segmentado -->
    <div class="reveal mt-10 inline-flex rounded-full bg-mist p-1" role="radiogroup" aria-label={c.sourceLabel}>
      {(['well', 'city'] as const).map((source) => (
        <button
          type="button"
          role="radio"
          aria-checked={source === 'well' ? 'true' : 'false'}
          data-source-btn={source}
          class="seg rounded-full px-7 py-2.5 text-[0.95rem] font-semibold transition sm:px-10"
        >
          {source === 'well' ? c.well : c.city}
        </button>
      ))}
    </div>

    <!-- Sintomas -->
    <div class="reveal mx-auto mt-8 grid max-w-3xl grid-cols-2 gap-3 sm:grid-cols-3">
      {CONCERNS.map((concern) => (
        <button type="button" class="tile group flex flex-col items-center gap-3 rounded-3xl bg-mist px-4 py-6 transition" data-concern-btn={concern.id} aria-pressed="false">
          <Icon name={concern.icon} class="h-7 w-7 text-accent" strokeWidth={1.6} />
          <span class="text-[0.98rem] font-semibold">{concern.label[lang]}</span>
        </button>
      ))}
    </div>

    <!-- Respuesta -->
    <div class="mx-auto mt-8 max-w-3xl text-left" aria-live="polite">
      <p class="text-center text-sm text-muted" data-hint>{c.hint}</p>
      {CONCERNS.map((concern) =>
        (['well', 'city'] as const).map((source) => {
          const r = concern.result[source];
          return (
            <article class="answer hidden rounded-4xl bg-night p-8 text-white sm:p-10" data-answer={`${concern.id}:${source}`}>
              <p class="text-sm font-medium text-white/60">{concern.label[lang]} · {source === 'well' ? c.well : c.city}</p>
              <h3 class="mt-2 text-3xl sm:text-4xl">{r.headline[lang]}</h3>
              <p class="mt-4 text-lg leading-relaxed text-white/80">{r.cause[lang]} {r.action[lang]}</p>
              <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
                <a href={`${formPath}?water_source=${source}&concerns=${concern.id}`} class="btn btn-primary" data-track="free_test_cta" data-location="water-check">{c.cta}</a>
                <a href={pathFor(r.pageKey, lang)} class="more !text-[#5ec2ff]">{c.more}</a>
              </div>
            </article>
          );
        })
      )}
    </div>
  </div>
</section>

<style>
  .seg[aria-checked='true'] { background: white; box-shadow: 0 1px 4px rgb(0 0 0 / 0.12); }
  .seg[aria-checked='false'] { color: var(--color-muted); }
  .tile:hover { background: #ebebef; }
  .tile[aria-pressed='true'] { background: var(--color-night); color: white; }
  .tile[aria-pressed='true'] svg { color: #5ec2ff; }
  .answer:not(.hidden) { animation: pop 0.45s cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes pop { from { opacity: 0; transform: translateY(12px) scale(0.98); } to { opacity: 1; transform: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-water-check]').forEach((root) => {
    let source = 'well';
    let concern: string | null = null;

    const render = () => {
      root.querySelectorAll<HTMLElement>('[data-source-btn]').forEach((btn) =>
        btn.setAttribute('aria-checked', String(btn.dataset.sourceBtn === source))
      );
      root.querySelectorAll<HTMLElement>('[data-concern-btn]').forEach((btn) =>
        btn.setAttribute('aria-pressed', String(btn.dataset.concernBtn === concern))
      );
      root.querySelectorAll<HTMLElement>('[data-answer]').forEach((el) =>
        el.classList.toggle('hidden', el.dataset.answer !== `${concern}:${source}`)
      );
      root.querySelector('[data-hint]')?.classList.toggle('hidden', concern !== null);
    };

    root.querySelectorAll<HTMLElement>('[data-source-btn]').forEach((btn) =>
      btn.addEventListener('click', () => {
        source = btn.dataset.sourceBtn!;
        render();
      })
    );
    root.querySelectorAll<HTMLElement>('[data-concern-btn]').forEach((btn) =>
      btn.addEventListener('click', () => {
        concern = btn.dataset.concernBtn!;
        render();
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'water_check', water_source: source, concern });
      })
    );
  });
</script>
