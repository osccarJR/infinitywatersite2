---
/**
 * Cierre comun: un titular, una frase y dos acciones. Nada mas.
 */
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import { pathFor } from '../i18n/routes';
import { WHATSAPP_MESSAGE, whatsappUrl } from '../config/business';

interface Props {
  lang: Lang;
  title?: string;
  text?: string;
  location?: string;
}

const { lang, location = 'final-cta' } = Astro.props;
const es = lang === 'es';
const ui = t(lang);
const title = Astro.props.title ?? (es ? '¿Qué hay en tu agua?' : 'What’s in your water?');
const text = Astro.props.text ?? (es ? 'Descúbrelo gratis. Sin presión y en español.' : 'Find out for free. No pressure.');
---

<section class="bg-night py-24 text-center text-white sm:py-32">
  <div class="container-x">
    <h2 class="t-section reveal">{title}</h2>
    <p class="reveal mt-4 text-xl text-white/65 sm:text-2xl">{text}</p>
    <div class="reveal mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-8">
      <a href={pathFor('freeWaterTest', lang)} class="btn btn-primary !min-h-13 !px-8 !text-lg" data-track="free_test_cta" data-location={location}>{ui.cta.freeTest}</a>
      <a href={whatsappUrl(WHATSAPP_MESSAGE[lang])} target="_blank" rel="noopener" class="more !text-lg !text-[#5ec2ff]" data-track="whatsapp" data-location={location}>{ui.cta.whatsapp}</a>
    </div>
  </div>
</section>
