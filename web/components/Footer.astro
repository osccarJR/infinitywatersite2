---
/**
 * Pie al estilo de Apple: gris claro, letra pequena, todo el mapa del sitio
 * ordenado en columnas. Aqui es donde vive el "resto" de enlaces, para que
 * la cabecera y las paginas puedan ser simples.
 *
 * Incluye el bloque de identidad legal que revisa la operadora A2P:
 * entidad, marca, direccion, contacto y enlaces legales en todas las paginas.
 */
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import { pathFor, pagesOfKind, contentPath } from '../i18n/routes';
import { labelOf } from '../data/labels';
import {
  ADDRESS_LINE_1,
  ADDRESS_LINE_2,
  EMAIL,
  HOURS_LABEL,
  IDENTITY_STATEMENT,
  LEGAL_ENTITY_DBA,
  PRIMARY_PHONE,
  SECONDARY_PHONE,
  SMS_PHONE_NUMBER,
  SUPPORT_PHONE,
  WHATSAPP_MESSAGE,
  whatsappUrl,
} from '../config/business';

interface Props {
  lang: Lang;
  /** Paginas de aterrizaje: solo el bloque legal (A2P). */
  minimal?: boolean;
}

const { lang, minimal = false } = Astro.props;
const es = lang === 'es';
const ui = t(lang);
const link = (key: string) => pathFor(key, lang);
const year = new Date().getFullYear();
const pages = (kind: Parameters<typeof pagesOfKind>[0]) =>
  pagesOfKind(kind).map((page) => ({ href: contentPath(page, lang), label: labelOf(page, lang) }));

const columns = [
  {
    title: es ? 'Tu agua' : 'Your water',
    items: [
      { href: link('well-water'), label: ui.nav.wellWater },
      { href: link('city-water'), label: ui.nav.cityWater },
      ...pages('problem'),
      { href: link('hurricane-well-care'), label: es ? 'Después del huracán' : 'After a hurricane' },
    ],
  },
  { title: ui.nav.services, items: pages('service') },
  { title: es ? 'Zonas' : 'Areas', items: pages('city') },
  {
    title: 'Infinity Water',
    items: [
      { href: link('about'), label: ui.nav.about },
      { href: link('financing'), label: ui.nav.financing },
      { href: link('faq'), label: ui.nav.faq },
      { href: link('contact'), label: ui.nav.contact },
      { href: link('freeWaterTest'), label: ui.cta.freeTestShort },
    ],
  },
  {
    title: ui.footer.contact,
    items: [
      { href: whatsappUrl(WHATSAPP_MESSAGE[lang]), label: 'WhatsApp', track: 'whatsapp', external: true },
      { href: `tel:${PRIMARY_PHONE.tel}`, label: PRIMARY_PHONE.display, track: 'call' },
      { href: `tel:${SECONDARY_PHONE.tel}`, label: SECONDARY_PHONE.display, track: 'call' },
      { href: `mailto:${EMAIL}`, label: EMAIL },
    ],
    note: HOURS_LABEL[lang],
  },
];

const legal = [
  { href: link('privacy'), label: ui.footer.privacy },
  { href: link('terms'), label: ui.footer.terms },
  { href: link('smsPolicy'), label: ui.footer.smsPolicy },
  { href: link('contact'), label: ui.nav.contact },
  { href: link('freeWaterTest'), label: ui.cta.freeTestShort },
];
---

<footer class="bg-mist text-[0.78rem] leading-relaxed text-muted">
  <div class="container-x py-12">
    {!minimal && <div class="grid grid-cols-2 gap-x-6 gap-y-8 border-b border-line pb-8 sm:grid-cols-3 lg:grid-cols-5">
      {columns.map((col) => (
        <div>
          <h2 class="mb-2.5 text-[0.78rem] font-semibold tracking-normal text-ink">{col.title}</h2>
          <ul class="space-y-2">
            {col.items.map((item: any) => (
              <li>
                <a
                  href={item.href}
                  class="break-words hover:text-ink hover:underline"
                  {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
                  {...(item.track ? { 'data-track': item.track, 'data-location': 'footer' } : {})}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          {col.note && <p class="mt-3">{col.note}</p>}
        </div>
      ))}
    </div>}

    <!-- Identidad legal (A2P): visible en todas las paginas. -->
    <div class="space-y-1 border-b border-line py-6">
      <p class="font-semibold text-ink">{LEGAL_ENTITY_DBA}</p>
      <p>{IDENTITY_STATEMENT[lang]}</p>
      <p>
        {ADDRESS_LINE_1}, {ADDRESS_LINE_2} · <a href={`mailto:${EMAIL}`} class="hover:text-ink hover:underline">{EMAIL}</a> ·
        <a href={`tel:${SUPPORT_PHONE.tel}`} class="hover:text-ink hover:underline" data-track="call" data-location="footer-legal">{ui.footer.support}: {SUPPORT_PHONE.display}</a>
        {SMS_PHONE_NUMBER && <span> · {ui.footer.sms}: {SMS_PHONE_NUMBER}</span>}
      </p>
    </div>

    <div class="flex flex-col gap-3 pt-5 lg:flex-row lg:items-center lg:justify-between">
      <p>Copyright © {year} {LEGAL_ENTITY_DBA}. {ui.footer.rights}</p>
      <nav aria-label={ui.footer.legal}>
        <ul class="flex flex-wrap gap-y-1">
          {legal.map((item, i) => (
            <li class:list={[i > 0 && 'border-l border-line', 'px-2.5 first:pl-0']}>
              <a href={item.href} class="text-ink/80 hover:text-ink hover:underline">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <p class="mt-4">
      {ui.footer.madeBy} <a href="https://www.nivusoftware.com/" target="_blank" rel="noopener" class="hover:text-ink hover:underline">Nivusoftware</a>
    </p>
  </div>
</footer>
