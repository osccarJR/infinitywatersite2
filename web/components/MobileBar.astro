---
/**
 * Barra inferior fija en movil: la accion principal siempre a un toque.
 * Aparece en cuanto el usuario empieza a bajar. En el formulario solo ofrece
 * WhatsApp y llamada (el formulario ya esta en pantalla).
 */
import Icon from './Icon.astro';
import type { Lang } from '../data/types';
import { t } from '../i18n/ui';
import { pathFor } from '../i18n/routes';
import { PRIMARY_PHONE, WHATSAPP_MESSAGE, whatsappUrl } from '../config/business';

interface Props {
  lang: Lang;
  onFormPage?: boolean;
}

const { lang, onFormPage = false } = Astro.props;
const ui = t(lang);
---

<div
  id="mobile-bar"
  class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-black/5 bg-white/85 px-4 pt-2.5 backdrop-blur-xl backdrop-saturate-150 transition-transform duration-300 lg:hidden"
  style="padding-bottom: calc(0.625rem + env(safe-area-inset-bottom));"
>
  <div class="mx-auto flex max-w-md items-center gap-2">
    <a href={whatsappUrl(WHATSAPP_MESSAGE[lang])} target="_blank" rel="noopener" class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-wa text-white" data-track="whatsapp" data-location="mobile-bar" aria-label="WhatsApp">
      <Icon name="MessageCircle" class="h-5 w-5" />
    </a>
    <a href={`tel:${PRIMARY_PHONE.tel}`} class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-mist text-ink" data-track="call" data-location="mobile-bar" aria-label={`${ui.cta.call} ${PRIMARY_PHONE.display}`}>
      <Icon name="Phone" class="h-5 w-5" />
    </a>
    {onFormPage ? (
      <a href={`tel:${PRIMARY_PHONE.tel}`} class="btn btn-dark h-12 flex-1" data-track="call" data-location="mobile-bar">{PRIMARY_PHONE.display}</a>
    ) : (
      <a href={pathFor('freeWaterTest', lang)} class="btn btn-primary h-12 min-w-0 flex-1 !px-4" data-track="free_test_cta" data-location="mobile-bar">
        <span class="min-[400px]:hidden">{ui.cta.freeTestShort}</span><span class="hidden min-[400px]:inline">{ui.cta.freeTest}</span>
      </a>
    )}
  </div>
</div>

<script>
  const bar = document.getElementById('mobile-bar');
  if (bar) {
    // Aparece en cuanto el usuario empieza a bajar: la accion principal
    // nunca debe quedar fuera de alcance.
    const update = () => bar.classList.toggle('translate-y-full', window.scrollY < 160);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
